<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Акцент -->
    <SolidColorBrush x:Key="BrandBrush" Color="#6366F1"/>
    <SolidColorBrush x:Key="BrandLightBrush" Color="#818CF8"/>
    <SolidColorBrush x:Key="BrandSoftBrush" Color="#EEF2FF"/>

    <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6366F1" Offset="0"/>
        <GradientStop Color="#8B5CF6" Offset="1"/>
    </LinearGradientBrush>

    <!-- Боковая панель -->
    <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0F172A" Offset="0"/>
        <GradientStop Color="#0B1120" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="NavHoverBrush" Color="#1A2336"/>
    <SolidColorBrush x:Key="NavActiveBrush" Color="#232F4A"/>
    <SolidColorBrush x:Key="SidebarLineBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="SidebarCaptionBrush" Color="#5A6782"/>

    <!-- Текст -->
    <SolidColorBrush x:Key="TextOnDarkBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="TextMutedOnDarkBrush" Color="#8A97AF"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B"/>

    <!-- Поверхности -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="CanvasBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="LineBrush" Color="#E2E8F0"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#F43F5E"/>

</ResourceDictionary>
