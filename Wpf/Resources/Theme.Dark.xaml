<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Тёмная тема. Набор ключей обязан совпадать со светлой темой. -->

    <!-- ============ Токены дизайн-системы ============ -->

    <SolidColorBrush x:Key="BgBrush"          Color="#0E1317"/>
    <SolidColorBrush x:Key="SurfaceBrush"     Color="#161C22"/>
    <SolidColorBrush x:Key="Surface2Brush"    Color="#1B2229"/>
    <SolidColorBrush x:Key="LineBrush"        Color="#28313A"/>
    <SolidColorBrush x:Key="TextBrush"        Color="#E7EDF2"/>
    <SolidColorBrush x:Key="MutedBrush"       Color="#94A2B0"/>
    <SolidColorBrush x:Key="PrimaryBrush"     Color="#2FA79A"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#3DBAAC"/>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#132A28"/>
    <SolidColorBrush x:Key="SuccessBrush"     Color="#35B36B"/>
    <SolidColorBrush x:Key="WarningBrush"     Color="#D9922F"/>
    <SolidColorBrush x:Key="DangerBrush"      Color="#E4636A"/>
    <SolidColorBrush x:Key="FieldBrush"       Color="#101519"/>

    <LinearGradientBrush x:Key="NavBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0E211F" Offset="0"/>
        <GradientStop Color="#0A1817" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="NavActiveBrush"  Color="#18232B"/>
    <SolidColorBrush x:Key="NavLineBrush"    Color="#1E2830"/>
    <SolidColorBrush x:Key="NavTextBrush"    Color="#9AA9B4"/>
    <SolidColorBrush x:Key="NavCaptionBrush" Color="#66757F"/>

    <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2FA79A" Offset="0"/>
        <GradientStop Color="#12A08F" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="OverlayBrush" Color="#0E1317" Opacity="0.7"/>

    <!-- ============ Совместимость со старыми именами ============ -->

    <SolidColorBrush x:Key="BrandBrush"          Color="#2FA79A"/>
    <SolidColorBrush x:Key="BrandLightBrush"     Color="#3DBAAC"/>
    <SolidColorBrush x:Key="BrandSoftBrush"      Color="#132A28"/>
    <SolidColorBrush x:Key="CanvasBrush"         Color="#0E1317"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush"   Color="#1B2229"/>
    <SolidColorBrush x:Key="TextPrimaryBrush"    Color="#E7EDF2"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"  Color="#94A2B0"/>
    <SolidColorBrush x:Key="TextOnDarkBrush"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextMutedOnDarkBrush" Color="#9AA9B4"/>
    <SolidColorBrush x:Key="NavHoverBrush"       Color="#18232B"/>
    <SolidColorBrush x:Key="SidebarLineBrush"    Color="#1E2830"/>
    <SolidColorBrush x:Key="SidebarCaptionBrush" Color="#66757F"/>

    <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0E211F" Offset="0"/>
        <GradientStop Color="#0A1817" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
