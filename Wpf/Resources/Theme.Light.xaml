<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Светлая тема. Ключи совпадают с Theme.Dark.xaml один в один: словарь целиком
        подменяется в рантайме, поэтому все кисти в разметке берутся через DynamicResource.
    -->

    <!-- ============ Токены дизайн-системы ============ -->

    <SolidColorBrush x:Key="BgBrush"          Color="#F1F3F0"/>
    <SolidColorBrush x:Key="SurfaceBrush"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Surface2Brush"    Color="#F7F8F6"/>
    <SolidColorBrush x:Key="LineBrush"        Color="#E3E6E1"/>
    <SolidColorBrush x:Key="TextBrush"        Color="#14181C"/>
    <SolidColorBrush x:Key="MutedBrush"       Color="#6B7480"/>
    <SolidColorBrush x:Key="PrimaryBrush"     Color="#0D7A6F"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#0F8C7F"/>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#E3F1EE"/>
    <SolidColorBrush x:Key="SuccessBrush"     Color="#1F9254"/>
    <SolidColorBrush x:Key="WarningBrush"     Color="#C0781F"/>
    <SolidColorBrush x:Key="DangerBrush"      Color="#C6353C"/>
    <SolidColorBrush x:Key="FieldBrush"       Color="#FFFFFF"/>

    <!-- Сайдбар тёмный в обеих темах -->
    <LinearGradientBrush x:Key="NavBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0E211F" Offset="0"/>
        <GradientStop Color="#0A1817" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="NavActiveBrush"  Color="#173432"/>
    <SolidColorBrush x:Key="NavLineBrush"    Color="#1C3634"/>
    <SolidColorBrush x:Key="NavTextBrush"    Color="#B9C4C1"/>
    <SolidColorBrush x:Key="NavCaptionBrush" Color="#6E8380"/>

    <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0D7A6F" Offset="0"/>
        <GradientStop Color="#12A08F" Offset="1"/>
    </LinearGradientBrush>

    <!-- Полупрозрачная заливка поверх контента на время загрузки -->
    <SolidColorBrush x:Key="OverlayBrush" Color="#F1F3F0" Opacity="0.7"/>

    <!-- ============ Совместимость со старыми именами ============ -->
    <!-- Разметка писалась до редизайна; чтобы не переименовывать ключи во всех
         экранах разом, старые имена оставлены псевдонимами новых токенов. -->

    <SolidColorBrush x:Key="BrandBrush"          Color="#0D7A6F"/>
    <SolidColorBrush x:Key="BrandLightBrush"     Color="#0F8C7F"/>
    <SolidColorBrush x:Key="BrandSoftBrush"      Color="#E3F1EE"/>
    <SolidColorBrush x:Key="CanvasBrush"         Color="#F1F3F0"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush"   Color="#F7F8F6"/>
    <SolidColorBrush x:Key="TextPrimaryBrush"    Color="#14181C"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"  Color="#6B7480"/>
    <SolidColorBrush x:Key="TextOnDarkBrush"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextMutedOnDarkBrush" Color="#B9C4C1"/>
    <SolidColorBrush x:Key="NavHoverBrush"       Color="#173432"/>
    <SolidColorBrush x:Key="SidebarLineBrush"    Color="#1C3634"/>
    <SolidColorBrush x:Key="SidebarCaptionBrush" Color="#6E8380"/>

    <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0E211F" Offset="0"/>
        <GradientStop Color="#0A1817" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
