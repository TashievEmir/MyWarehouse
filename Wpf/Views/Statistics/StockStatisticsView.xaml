<UserControl x:Class="Wpf.Views.Statistics.StockStatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:common="clr-namespace:Wpf.Common"
             xmlns:vm="clr-namespace:Wpf.ViewModels.Statistics"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <common:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Плашка с числом -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CanvasBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Шапка категории: кликом раскрывается список товаров -->
        <Style x:Key="CategoryHeader" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="14,12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StockBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource CanvasBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource BrandBrush}"/>
        </Style>

        <!-- ============ Товар внутри категории ============ -->
        <DataTemplate DataType="{x:Type vm:ProductStatItem}">
            <Grid Margin="14,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Name}"
                               FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"/>

                    <TextBlock Text="{Binding BarcodeText}"
                               FontSize="11"
                               Margin="0,2,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding StockRatio}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </Grid>
        </DataTemplate>

        <!-- ============ Категория ============ -->
        <DataTemplate DataType="{x:Type vm:CategoryStatItem}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>

                    <ToggleButton Style="{StaticResource CategoryHeader}"
                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <materialDesign:PackIcon Grid.Column="0"
                                                     Width="20"
                                                     Height="20"
                                                     VerticalAlignment="Center"
                                                     Foreground="{StaticResource TextSecondaryBrush}">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="ChevronRight"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                <Setter Property="Kind" Value="ChevronDown"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>

                            <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock Text="{Binding ProductsCountText}"
                                           Style="{StaticResource Muted}"
                                           FontSize="11"
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                <ProgressBar Style="{StaticResource StockBar}"
                                             Width="120"
                                             Margin="0,0,14,0"
                                             VerticalAlignment="Center"
                                             Value="{Binding StockShare, Mode=OneWay}"/>

                                <Border Style="{StaticResource Chip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding StockRatio}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>

                                        <TextBlock Text="шт."
                                                   FontSize="11"
                                                   Margin="5,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ToggleButton>

                    <Border BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="0,6,0,10"
                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">

                        <ItemsControl ItemsSource="{Binding Products}"/>
                    </Border>

                </StackPanel>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ Фильтр по датам ============ -->
        <Border Grid.Row="0"
                Style="{StaticResource Card}"
                Padding="16,14"
                Margin="0,0,0,14">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Остатки по категориям" Style="{StaticResource SectionTitle}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Style="{StaticResource Muted}" Text="Период:"/>
                        <TextBlock Style="{StaticResource Muted}"
                                   Margin="5,0,0,0"
                                   FontWeight="SemiBold"
                                   Text="{Binding PeriodText}"/>

                        <TextBlock Style="{StaticResource Muted}" Margin="12,0,0,0" Text="·"/>

                        <TextBlock Style="{StaticResource Muted}" Margin="12,0,0,0" Text="На складе:"/>
                        <TextBlock Style="{StaticResource Muted}"
                                   Margin="5,0,0,0"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding TotalInStock}"/>

                        <TextBlock Style="{StaticResource Muted}" Margin="12,0,0,0" Text="Поступило:"/>
                        <TextBlock Style="{StaticResource Muted}"
                                   Margin="5,0,0,0"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding TotalReceived}"/>
                    </StackPanel>

                    <TextBlock Margin="0,6,0,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource DangerBrush}"
                               Text="{Binding ErrorMessage}"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="ОТ" Style="{StaticResource FieldCaption}"/>
                        <DatePicker Style="{StaticResource FieldDate}"
                                    Width="140"
                                    SelectedDate="{Binding From, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="ДО" Style="{StaticResource FieldCaption}"/>
                        <DatePicker Style="{StaticResource FieldDate}"
                                    Width="140"
                                    SelectedDate="{Binding To, Mode=TwoWay}"/>
                    </StackPanel>

                    <Button Style="{StaticResource PrimaryButton}"
                            Margin="0,17,8,0"
                            Content="Показать"
                            Command="{Binding RefreshCommand}"/>

                    <Button Style="{StaticResource SecondaryButton}"
                            Margin="0,17,0,0"
                            Content="Сбросить"
                            Command="{Binding ResetPeriodCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Категории ============ -->
        <Grid Grid.Row="1">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,8,0">

                <ItemsControl ItemsSource="{Binding Stats}"/>
            </ScrollViewer>

            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">

                <materialDesign:PackIcon Kind="ChartLine"
                                         Width="46"
                                         Height="46"
                                         HorizontalAlignment="Center"
                                         Foreground="{StaticResource LineBrush}"/>

                <TextBlock Text="За этот период товаров нет"
                           Margin="0,10,0,0"
                           FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>

            <Border Background="#B3F1F5F9"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">

                <TextBlock Text="Загрузка…"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
