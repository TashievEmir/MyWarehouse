<UserControl x:Class="Wpf.Views.Statistics.DebtsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:common="clr-namespace:Wpf.Common"
             xmlns:vm="clr-namespace:Wpf.ViewModels.Statistics"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <common:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <common:EmptyStringToVisibilityConverter x:Key="EmptyToVisibility"/>

        <Style x:Key="DebtRow" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Margin="0,0,0,6"
                                Padding="12,10"
                                CornerRadius="10"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1"
                                SnapsToDevicePixels="True">

                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Долг ============ -->
        <DataTemplate DataType="{x:Type vm:DebtItem}">
            <Button Style="{StaticResource DebtRow}"
                    Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="180"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding ContactText}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>

                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding SaleNumber}" Style="{StaticResource Muted}" FontSize="11"/>
                            <TextBlock Text="{Binding DateText}" Style="{StaticResource Muted}" FontSize="11" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{Binding ProgressText}"
                               Style="{StaticResource Muted}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <TextBlock Grid.Column="2"
                               Text="{Binding PaymentsText}"
                               Style="{StaticResource Muted}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <Border Grid.Column="3"
                            CornerRadius="8"
                            Padding="10,5"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="{DynamicResource CanvasBrush}">

                        <TextBlock Text="{Binding Debt, StringFormat={}{0:N2}}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource DangerBrush}"/>
                    </Border>
                </Grid>
            </Button>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16,14">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Шапка -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Долги клиентов" Style="{StaticResource SectionTitle}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Style="{StaticResource Muted}" Text="Всего долга:"/>
                            <TextBlock Style="{StaticResource Muted}"
                                       Margin="5,0,0,0"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource DangerBrush}"
                                       Text="{Binding TotalDebt, StringFormat={}{0:N2}}"/>

                            <TextBlock Style="{StaticResource Muted}" Margin="12,0,0,0" Text="·"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="12,0,0,0" Text="{Binding CountText}"/>
                        </StackPanel>

                        <TextBlock Margin="0,6,0,0"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Text="{Binding StatusMessage}"
                                   Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">

                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <Grid Grid.Column="1" Width="320" VerticalAlignment="Center">
                        <TextBox Style="{StaticResource Field}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"/>

                        <TextBlock Text="Поиск по клиенту, телефону или чеку"
                                   Margin="13,0,0,0"
                                   FontSize="13"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding SearchText, Converter={StaticResource EmptyToVisibility}}"/>

                        <Button Style="{StaticResource MiniIconButton}"
                                HorizontalAlignment="Right"
                                Margin="0,0,6,0"
                                ToolTip="Очистить поиск"
                                Command="{Binding ClearSearchCommand}"
                                Visibility="{Binding HasSearch, Converter={StaticResource BoolToVisibility}}">

                            <materialDesign:PackIcon Kind="Close" Width="15" Height="15"/>
                        </Button>
                    </Grid>
                </Grid>

                <!-- Шапка списка -->
                <Grid Grid.Row="1" Margin="12,0,12,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="180"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="КЛИЕНТ" Style="{StaticResource FieldCaption}"/>
                    <TextBlock Grid.Column="1" Text="ОПЛАЧЕНО" Style="{StaticResource FieldCaption}"/>
                    <TextBlock Grid.Column="2" Text="ПЛАТЕЖИ" Style="{StaticResource FieldCaption}"/>
                    <TextBlock Grid.Column="3" Text="ДОЛГ" Style="{StaticResource FieldCaption}" TextAlignment="Right" Margin="0,0,2,5"/>
                </Grid>

                <!-- Список -->
                <Grid Grid.Row="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,6,0">

                        <ItemsControl ItemsSource="{Binding Debts}"/>
                    </ScrollViewer>

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">

                        <materialDesign:PackIcon Kind="CheckCircleOutline"
                                                 Width="46"
                                                 Height="46"
                                                 HorizontalAlignment="Center"
                                                 Foreground="{DynamicResource LineBrush}"/>

                        <TextBlock Text="Непогашенных долгов нет"
                                   Margin="0,10,0,0"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ============ Приём оплаты ============ -->
        <Border Grid.Column="1"
                Width="360"
                Margin="14,0,0,0"
                Style="{StaticResource Card}"
                Padding="18,16"
                DataContext="{Binding Selected}"
                Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">

            <StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="{Binding CustomerName}"
                                   Style="{StaticResource SectionTitle}"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock Text="{Binding SaleNumber}"
                                   Style="{StaticResource Muted}"
                                   FontSize="12"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource MiniIconButton}"
                            VerticalAlignment="Top"
                            ToolTip="Закрыть"
                            Command="{Binding DataContext.CloseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">

                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                    </Button>
                </Grid>

                <Border Height="1" Margin="0,14" Background="{DynamicResource LineBrush}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Сумма чека" Style="{StaticResource Muted}" FontSize="13"/>
                    <TextBlock Grid.Column="1"
                               FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{Binding TotalAmount, StringFormat={}{0:N2}}"/>
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Уже оплачено" Style="{StaticResource Muted}" FontSize="13"/>
                    <TextBlock Grid.Column="1"
                               FontSize="13"
                               Foreground="{DynamicResource SuccessBrush}"
                               Text="{Binding PaidAmount, StringFormat={}{0:N2}}"/>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Остаток долга"
                               FontSize="15"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <TextBlock Grid.Column="1"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DangerBrush}"
                               Text="{Binding Debt, StringFormat={}{0:N2}}"/>
                </Grid>

                <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">

                    <TextBlock Text="ПРИНЯТЬ ОПЛАТУ" Style="{StaticResource FieldCaption}" Margin="0,18,0,8"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Style="{StaticResource Field}"
                                 FontSize="15"
                                 TextAlignment="Right"
                                 ToolTip="Сумма платежа"
                                 Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged}"/>

                        <Button Grid.Column="1"
                                Style="{StaticResource SecondaryButton}"
                                Margin="6,0,0,0"
                                Content="Весь долг"
                                Command="{Binding PayFullCommand}"/>
                    </Grid>

                    <Button Style="{StaticResource PrimaryButton}"
                            Height="44"
                            Margin="0,12,0,0"
                            Command="{Binding PayCommand}">

                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CashCheck" Width="19" Height="19" VerticalAlignment="Center"/>
                            <TextBlock Text="Принять оплату" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
