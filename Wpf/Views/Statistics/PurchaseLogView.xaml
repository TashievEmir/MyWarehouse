<UserControl x:Class="Wpf.Views.Statistics.PurchaseLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:common="clr-namespace:Wpf.Common"
             xmlns:vm="clr-namespace:Wpf.ViewModels.Statistics"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <common:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <common:EmptyStringToVisibilityConverter x:Key="EmptyToVisibility"/>

        <Style x:Key="PurchaseHeader" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="14,12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Позиция поставки ============ -->
        <DataTemplate DataType="{x:Type vm:PurchaseLineItem}">
            <Grid Margin="14,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="{Binding ProductName}"
                               FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"/>

                    <TextBlock Text="{Binding Barcode}"
                               Style="{StaticResource Muted}"
                               FontSize="11"
                               FontFamily="Consolas"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding QuantityText}"
                           Style="{StaticResource Muted}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextAlignment="Right"
                           Margin="0,0,12,0"/>

                <TextBlock Grid.Column="2"
                           Text="{Binding Total, StringFormat={}{0:N2}}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Grid>
        </DataTemplate>

        <!-- ============ Поставка ============ -->
        <DataTemplate DataType="{x:Type vm:PurchaseLogItem}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>

                    <ToggleButton Style="{StaticResource PurchaseHeader}"
                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <materialDesign:PackIcon Grid.Column="0"
                                                     Width="20"
                                                     Height="20"
                                                     VerticalAlignment="Center"
                                                     Foreground="{DynamicResource TextSecondaryBrush}">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="ChevronRight"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                <Setter Property="Kind" Value="ChevronDown"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>

                            <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SupplierName}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>

                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding Number}" Style="{StaticResource Muted}" FontSize="11"/>
                                    <TextBlock Text="{Binding DateText}" Style="{StaticResource Muted}" FontSize="11" Margin="8,0,0,0"/>
                                    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Muted}" FontSize="11" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="2"
                                    CornerRadius="8"
                                    Padding="10,5"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource CanvasBrush}">

                                <TextBlock Text="{Binding TotalCost, StringFormat={}{0:N2}}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Border>
                        </Grid>
                    </ToggleButton>

                    <Border BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="0,6,0,10"
                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">

                        <ItemsControl ItemsSource="{Binding Lines}"/>
                    </Border>

                </StackPanel>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ Фильтр ============ -->
        <Border Grid.Row="0"
                Style="{StaticResource Card}"
                Padding="16,14"
                Margin="0,0,0,14">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Журнал закупок" Style="{StaticResource SectionTitle}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Style="{StaticResource Muted}" Text="Период:"/>
                        <TextBlock Style="{StaticResource Muted}"
                                   Margin="5,0,0,0"
                                   FontWeight="SemiBold"
                                   Text="{Binding PeriodText}"/>

                        <TextBlock Style="{StaticResource Muted}" Margin="12,0,0,0" Text="·"/>

                        <TextBlock Style="{StaticResource Muted}" Margin="12,0,0,0" Text="Потрачено:"/>
                        <TextBlock Style="{StaticResource Muted}"
                                   Margin="5,0,0,0"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding TotalCost, StringFormat={}{0:N2}}"/>

                        <TextBlock Style="{StaticResource Muted}" Margin="12,0,0,0" Text="Принято:"/>
                        <TextBlock Style="{StaticResource Muted}"
                                   Margin="5,0,0,0"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding TotalItems, StringFormat={}{0} шт.}"/>

                        <TextBlock Style="{StaticResource Muted}" Margin="12,0,0,0" Text="{Binding CountText}"/>
                    </StackPanel>

                    <TextBlock Margin="0,6,0,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DangerBrush}"
                               Text="{Binding ErrorMessage}"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                    <Grid Width="240" Margin="0,17,10,0">
                        <TextBox Style="{StaticResource Field}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"/>

                        <TextBlock Text="Поставщик или товар"
                                   Margin="13,0,0,0"
                                   FontSize="13"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding SearchText, Converter={StaticResource EmptyToVisibility}}"/>

                        <Button Style="{StaticResource MiniIconButton}"
                                HorizontalAlignment="Right"
                                Margin="0,0,6,0"
                                ToolTip="Очистить поиск"
                                Command="{Binding ClearSearchCommand}"
                                Visibility="{Binding HasSearch, Converter={StaticResource BoolToVisibility}}">

                            <materialDesign:PackIcon Kind="Close" Width="15" Height="15"/>
                        </Button>
                    </Grid>

                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="ОТ" Style="{StaticResource FieldCaption}"/>
                        <DatePicker Style="{StaticResource FieldDate}"
                                    Width="140"
                                    SelectedDate="{Binding From, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="ДО" Style="{StaticResource FieldCaption}"/>
                        <DatePicker Style="{StaticResource FieldDate}"
                                    Width="140"
                                    SelectedDate="{Binding To, Mode=TwoWay}"/>
                    </StackPanel>

                    <Button Style="{StaticResource PrimaryButton}"
                            Margin="0,17,8,0"
                            Content="Показать"
                            Command="{Binding RefreshCommand}"/>

                    <Button Style="{StaticResource SecondaryButton}"
                            Margin="0,17,0,0"
                            Content="Сбросить"
                            Command="{Binding ResetPeriodCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Поставки ============ -->
        <Grid Grid.Row="1">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,8,0">

                <ItemsControl ItemsSource="{Binding Purchases}"/>
            </ScrollViewer>

            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">

                <materialDesign:PackIcon Kind="CartOutline"
                                         Width="46"
                                         Height="46"
                                         HorizontalAlignment="Center"
                                         Foreground="{DynamicResource LineBrush}"/>

                <TextBlock Text="За этот период поставок не было"
                           Margin="0,10,0,0"
                           FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>

            <Border Background="#B3F1F5F9"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">

                <TextBlock Text="Загрузка…"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
