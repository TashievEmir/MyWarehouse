<Window x:Class="Wpf.Views.Login.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:common="clr-namespace:Wpf.Common"
        xmlns:loc="clr-namespace:Wpf.Localization"
        Title="{loc:Tr App_LoginTitle}"
        WindowState="Maximized"
        ResizeMode="CanResize"
        MinWidth="640"
        MinHeight="520"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI"
        Background="{DynamicResource NavBgBrush}">

    <Window.Resources>
        <common:EmptyStringToVisibilityConverter x:Key="EmptyToVisibility"/>
    </Window.Resources>

    <Grid>

        <!-- Язык до входа: кассир может не читать по-русски -->
        <Button HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,18,24,0"
                Style="{StaticResource SecondaryButton}"
                Height="34"
                Padding="12,0"
                Click="ToggleLanguage"
                ToolTip="{loc:Tr Tip_ToggleLanguage}">

            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Translate" Width="16" Height="16" VerticalAlignment="Center"/>

                <TextBlock Text="{Binding ToggleCode, Source={x:Static loc:Loc.Instance}}"
                           Margin="6,0,0,0"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <!-- Карточка входа по центру тёмного фона -->
        <Border Width="440"
                CornerRadius="16"
                Padding="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1">

            <StackPanel>

                <!-- Логотип как в приложении -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Width="42"
                            Height="42"
                            CornerRadius="13"
                            VerticalAlignment="Center"
                            Background="{DynamicResource BrandGradientBrush}">

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Rectangle Width="20" Height="4" RadiusX="2" RadiusY="2" Fill="#FFFFFF"/>
                            <Rectangle Width="14" Height="4" RadiusX="2" RadiusY="2" Fill="#FFFFFF" Opacity="0.7" Margin="0,3"/>
                            <Rectangle Width="20" Height="4" RadiusX="2" RadiusY="2" Fill="#FFFFFF"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Tr App_Title}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>

                        <TextBlock Text="{loc:Tr App_Tagline}"
                                   FontSize="12"
                                   Margin="0,1,0,0"
                                   Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="{loc:Tr Login_Title}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,26,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}"/>

                <TextBlock Text="{loc:Tr Login_Subtitle}"
                           FontSize="13"
                           Margin="0,6,0,0"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedBrush}"/>

                <!-- Логин -->
                <TextBlock Text="{loc:Tr Login_UsernameCaption}" Style="{StaticResource FieldCaption}" Margin="2,26,0,7"/>

                <Grid>
                    <TextBox x:Name="LoginBox"
                             Style="{StaticResource Field}"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="{loc:Tr Login_UsernameHint}"
                               Margin="15,0,0,0"
                               FontSize="15"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"
                               Visibility="{Binding Username, Converter={StaticResource EmptyToVisibility}}"/>
                </Grid>

                <!-- Пароль -->
                <TextBlock Text="{loc:Tr Login_PasswordCaption}" Style="{StaticResource FieldCaption}" Margin="2,16,0,7"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <PasswordBox x:Name="PasswordBox"
                                 Grid.Column="0"
                                 Style="{StaticResource PasswordField}"
                                 KeyDown="OnPasswordKeyDown"/>

                    <TextBox x:Name="VisiblePassword"
                             Grid.Column="0"
                             Style="{StaticResource Field}"
                             Visibility="Collapsed"
                             KeyDown="OnPasswordKeyDown"/>

                    <Button Grid.Column="1"
                            Style="{StaticResource SecondaryButton}"
                            Height="48"
                            Width="48"
                            Padding="0"
                            Margin="8,0,0,0"
                            Click="TogglePassword"
                            ToolTip="{loc:Tr Login_ShowPassword}">

                        <materialDesign:PackIcon x:Name="EyeIcon" Kind="EyeOutline" Width="20" Height="20"/>
                    </Button>
                </Grid>

                <Button Style="{StaticResource PrimaryButton}"
                        Height="48"
                        Margin="0,24,0,0"
                        Command="{Binding LoginCommand}"
                        CommandParameter="{Binding ElementName=PasswordBox}">

                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Login" Width="19" Height="19" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr Login_Submit}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <TextBlock Margin="0,14,0,0"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource DangerBrush}"
                           Text="{Binding ErrorMessage}"/>

            </StackPanel>
        </Border>

        <TextBlock Text="{loc:Tr App_Version}"
                   FontSize="12"
                   Margin="0,0,0,20"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Foreground="{DynamicResource NavCaptionBrush}"/>
    </Grid>
</Window>
