<UserControl x:Class="Wpf.Views.Users.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:common="clr-namespace:Wpf.Common"
             xmlns:loc="clr-namespace:Wpf.Localization"
             xmlns:vm="clr-namespace:Wpf.ViewModels.Users"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1200"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <common:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <common:EmptyStringToVisibilityConverter x:Key="EmptyToVisibility"/>
        <common:ResourceKeyToBrushConverter x:Key="KeyToBrush"/>

        <!-- Строка списка -->
        <Style x:Key="UserRow" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Margin="0,0,0,6"
                                Padding="12,10"
                                CornerRadius="10"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1"
                                SnapsToDevicePixels="True">

                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Переключатель доступа -->
        <Style x:Key="AccessToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track"
                                Width="52"
                                Height="30"
                                CornerRadius="15"
                                Background="{DynamicResource LineBrush}">

                            <Border x:Name="Knob"
                                    Width="24"
                                    Height="24"
                                    Margin="3,0,0,0"
                                    CornerRadius="12"
                                    HorizontalAlignment="Left"
                                    Background="#FFFFFF"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Сотрудник в списке ============ -->
        <DataTemplate DataType="{x:Type vm:UserListItem}">
            <Button Style="{StaticResource UserRow}"
                    Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="180"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding FullName}"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding Username}"
                               Style="{StaticResource Muted}"
                               FontSize="12"
                               FontFamily="Consolas"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <TextBlock Grid.Column="2"
                               Text="{Binding RolesText}"
                               Style="{StaticResource Muted}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <Border Grid.Column="3"
                            CornerRadius="8"
                            Padding="9,4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="{DynamicResource CanvasBrush}">

                        <TextBlock Text="{Binding StateText}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding StateBrushKey, Converter={StaticResource KeyToBrush}}"/>
                    </Border>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- ============ Роль в карточке ============ -->
        <DataTemplate DataType="{x:Type vm:RoleOption}">
            <CheckBox Margin="0,0,0,8"
                      Cursor="Hand"
                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                      Content="{Binding Title}"
                      Foreground="{DynamicResource TextBrush}"/>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Список ============ -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16,14">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Поиск и создание -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <TextBox Style="{StaticResource Field}"
                                 FontSize="14"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"/>

                        <TextBlock Text="{loc:Tr Users_SearchHint}"
                                   Margin="13,0,0,0"
                                   FontSize="13"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding SearchText, Converter={StaticResource EmptyToVisibility}}"/>

                        <Button Style="{StaticResource MiniIconButton}"
                                HorizontalAlignment="Right"
                                Margin="0,0,6,0"
                                ToolTip="{loc:Tr Common_ClearSearch}"
                                Command="{Binding ClearSearchCommand}"
                                Visibility="{Binding HasSearch, Converter={StaticResource BoolToVisibility}}">

                            <materialDesign:PackIcon Kind="Close" Width="15" Height="15"/>
                        </Button>
                    </Grid>

                    <TextBlock Grid.Column="1"
                               Style="{StaticResource Muted}"
                               Margin="12,0,12,0"
                               VerticalAlignment="Center"
                               Text="{Binding CountText}"/>

                    <Button Grid.Column="2"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding NewCommand}">

                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountPlusOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr Users_New}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Шапка списка -->
                <Grid Grid.Row="1" Margin="12,0,12,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="180"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{loc:Tr Users_Col_Name}" Style="{StaticResource FieldCaption}"/>
                    <TextBlock Grid.Column="1" Text="{loc:Tr Users_Col_Login}" Style="{StaticResource FieldCaption}"/>
                    <TextBlock Grid.Column="2" Text="{loc:Tr Users_Col_Roles}" Style="{StaticResource FieldCaption}"/>
                    <TextBlock Grid.Column="3" Text="{loc:Tr Users_Col_State}" Style="{StaticResource FieldCaption}" TextAlignment="Right" Margin="0,0,2,5"/>
                </Grid>

                <!-- Строки -->
                <Grid Grid.Row="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,6,0">

                        <ItemsControl ItemsSource="{Binding Items}"/>
                    </ScrollViewer>

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">

                        <materialDesign:PackIcon Kind="AccountGroupOutline"
                                                 Width="44"
                                                 Height="44"
                                                 HorizontalAlignment="Center"
                                                 Foreground="{DynamicResource LineBrush}"/>

                        <TextBlock Text="{loc:Tr Users_Empty}"
                                   Margin="0,10,0,0"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ============ Карточка сотрудника ============ -->
        <Border Grid.Column="1"
                Width="390"
                Margin="14,0,0,0"
                Style="{StaticResource Card}"
                Padding="18,16"
                Visibility="{Binding HasEditor, Converter={StaticResource BoolToVisibility}}">

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="{Binding EditorTitle}"
                                       Style="{StaticResource SectionTitle}"
                                       TextTrimming="CharacterEllipsis"/>

                            <TextBlock Text="{loc:Tr Users_SelfHint}"
                                       Style="{StaticResource Muted}"
                                       FontSize="12"
                                       Margin="0,2,0,0"
                                       Visibility="{Binding IsSelf, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Style="{StaticResource MiniIconButton}"
                                VerticalAlignment="Top"
                                ToolTip="{loc:Tr Common_Close}"
                                Command="{Binding CloseCommand}">

                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="{loc:Tr Users_LastName}" Style="{StaticResource FieldCaption}" Margin="0,16,0,6"/>
                    <TextBox Style="{StaticResource Field}" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="{loc:Tr Users_FirstName}" Style="{StaticResource FieldCaption}" Margin="0,12,0,6"/>
                    <TextBox Style="{StaticResource Field}" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="{loc:Tr Users_Patronymic}" Style="{StaticResource FieldCaption}" Margin="0,12,0,6"/>
                    <TextBox Style="{StaticResource Field}" Text="{Binding Patronymic, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="{loc:Tr Users_Login}" Style="{StaticResource FieldCaption}" Margin="0,12,0,6"/>
                    <TextBox Style="{StaticResource Field}"
                             FontFamily="Consolas"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="{loc:Tr Users_Password}" Style="{StaticResource FieldCaption}" Margin="0,12,0,6"/>
                    <TextBox Style="{StaticResource Field}" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="{loc:Tr Users_PasswordKeep}"
                               Style="{StaticResource Muted}"
                               FontSize="12"
                               Margin="2,6,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>

                    <TextBlock Text="{loc:Tr Users_Roles}" Style="{StaticResource FieldCaption}" Margin="0,14,0,8"/>
                    <ItemsControl ItemsSource="{Binding Roles}"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{loc:Tr Users_AccessOn}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}"/>

                        <CheckBox Grid.Column="1"
                                  Style="{StaticResource AccessToggle}"
                                  IsChecked="{Binding IsActive, Mode=TwoWay}"/>
                    </Grid>

                    <Button Style="{StaticResource PrimaryButton}"
                            Height="44"
                            Margin="0,16,0,0"
                            Content="{loc:Tr Users_Save}"
                            Command="{Binding SaveCommand}"/>

                    <Border Height="1" Margin="0,16" Background="{DynamicResource LineBrush}"/>

                    <TextBlock Style="{StaticResource Muted}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Text="{Binding DeleteHint}"/>

                    <Button Style="{StaticResource SecondaryButton}"
                            Height="40"
                            Margin="0,8,0,0"
                            Foreground="{DynamicResource DangerBrush}"
                            IsEnabled="{Binding CanDelete}"
                            Content="{loc:Tr Users_Delete}"
                            Command="{Binding DeleteCommand}"/>

                    <TextBlock Margin="0,12,0,0"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Text="{Binding StatusMessage}"
                               Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
