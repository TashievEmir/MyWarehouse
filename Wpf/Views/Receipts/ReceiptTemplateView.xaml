<UserControl x:Class="Wpf.Views.Receipts.ReceiptTemplateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:common="clr-namespace:Wpf.Common"
             xmlns:loc="clr-namespace:Wpf.Localization"
             xmlns:vm="clr-namespace:Wpf.ViewModels.Receipts"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1200"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <common:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Переключатель блока -->
        <Style x:Key="BlockToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track"
                                Width="52"
                                Height="30"
                                CornerRadius="15"
                                Background="{DynamicResource LineBrush}">

                            <Border x:Name="Knob"
                                    Width="24"
                                    Height="24"
                                    Margin="3,0,0,0"
                                    CornerRadius="12"
                                    HorizontalAlignment="Left"
                                    Background="#FFFFFF"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Блок чека ============ -->
        <DataTemplate DataType="{x:Type vm:ReceiptBlockItem}">
            <Border Margin="0,0,0,8"
                    Padding="14,12"
                    CornerRadius="13"
                    Background="{DynamicResource Surface2Brush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Порядок меняется стрелками -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Button Style="{StaticResource MiniIconButton}"
                                Width="26"
                                Height="22"
                                ToolTip="{loc:Tr Template_MoveUp}"
                                Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">

                            <materialDesign:PackIcon Kind="ChevronUp" Width="16" Height="16"/>
                        </Button>

                        <Button Style="{StaticResource MiniIconButton}"
                                Width="26"
                                Height="22"
                                ToolTip="{loc:Tr Template_MoveDown}"
                                Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">

                            <materialDesign:PackIcon Kind="ChevronDown" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock Text="{Binding Hint}"
                                   FontSize="13"
                                   Margin="0,2,0,0"
                                   Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>

                    <CheckBox Grid.Column="2"
                              Style="{StaticResource BlockToggle}"
                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                              IsEnabled="{Binding CanToggle}"
                              ToolTip="{Binding Hint}"/>
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Редактор ============ -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,16">

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="{loc:Tr Template_Title}" Style="{StaticResource SectionTitle}"/>

                            <TextBlock Text="{loc:Tr Template_Subtitle}"
                                       FontSize="14"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                CornerRadius="9"
                                Padding="12,7"
                                VerticalAlignment="Top"
                                Background="{DynamicResource PrimarySoftBrush}">

                            <TextBlock Text="{Binding RoleChip}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryBrush}"/>
                        </Border>
                    </Grid>

                    <TextBlock Text="{loc:Tr Template_Header}" Style="{StaticResource FieldCaption}" Margin="0,22,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,7,0">
                            <TextBlock Text="{loc:Tr Template_ShopName}" Style="{StaticResource Muted}" Margin="2,0,0,7"/>
                            <TextBox Style="{StaticResource Field}" Text="{Binding ShopName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="7,0,0,0">
                            <TextBlock Text="{loc:Tr Template_Tin}" Style="{StaticResource Muted}" Margin="2,0,0,7"/>
                            <TextBox Style="{StaticResource Field}" Text="{Binding Tin, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="{loc:Tr Template_Address}" Style="{StaticResource Muted}" Margin="2,0,0,7"/>
                        <TextBox Style="{StaticResource Field}" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <TextBlock Text="{loc:Tr Template_Blocks}" Style="{StaticResource FieldCaption}" Margin="0,22,0,10"/>

                    <ItemsControl ItemsSource="{Binding Blocks}"/>

                    <TextBlock Text="{loc:Tr Template_Footer}" Style="{StaticResource FieldCaption}" Margin="0,14,0,10"/>
                    <TextBox Style="{StaticResource Field}" Text="{Binding FooterText, UpdateSourceTrigger=PropertyChanged}"/>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource PrimaryButton}"
                                Height="52"
                                FontSize="16"
                                Margin="0,0,10,0"
                                Command="{Binding SaveCommand}">

                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSaveOutline" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr Template_Save}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1"
                                Style="{StaticResource SecondaryButton}"
                                Height="52"
                                Content="{loc:Tr Template_TestPrint}"
                                Command="{Binding TestPrintCommand}"/>
                    </Grid>

                    <TextBlock Margin="0,12,0,0"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Text="{Binding StatusMessage}"
                               Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ============ Предпросмотр ============ -->
        <Border Grid.Column="1"
                Width="400"
                Margin="18,0,0,0"
                Style="{StaticResource Card}"
                Padding="18,16">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="{loc:Tr Template_Preview}" Style="{StaticResource BlockTitle}"/>
                    <TextBlock Text="{loc:Tr Template_PreviewHint}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                </StackPanel>

                <Border Grid.Row="1"
                        CornerRadius="13"
                        Padding="18"
                        Background="{DynamicResource Surface2Brush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding Preview}"
                                   FontFamily="Consolas"
                                   FontSize="14"
                                   LineHeight="22"
                                   TextWrapping="NoWrap"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
