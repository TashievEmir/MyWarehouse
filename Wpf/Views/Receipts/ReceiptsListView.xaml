<UserControl x:Class="Wpf.Views.Receipts.ReceiptsListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:common="clr-namespace:Wpf.Common"
             xmlns:vm="clr-namespace:Wpf.ViewModels.Receipts"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1200"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <common:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <common:EmptyStringToVisibilityConverter x:Key="EmptyToVisibility"/>
        <common:EqualsConverter x:Key="Equals"/>

        <!-- Чип быстрого периода -->
        <Style x:Key="PeriodChip" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Height="36"
                                Padding="14,0"
                                CornerRadius="10"
                                Background="{DynamicResource Surface2Brush}"
                                SnapsToDevicePixels="True">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Строка списка чеков -->
        <Style x:Key="ReceiptRow" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Margin="0,0,0,8"
                                Padding="14"
                                CornerRadius="13"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1"
                                SnapsToDevicePixels="True">

                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Чек в списке ============ -->
        <DataTemplate DataType="{x:Type vm:ReceiptListItem}">
            <Button Style="{StaticResource ReceiptRow}"
                    Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*" MinWidth="160"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding Number}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding TimeText}"
                               FontSize="15"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"/>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding CashierName}"
                                   FontSize="15"
                                   Foreground="{DynamicResource TextBrush}"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock Text="{Binding CustomerName}"
                                   FontSize="13"
                                   Margin="0,2,0,0"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <TextBlock Grid.Column="3"
                               Text="{Binding PositionsText}"
                               FontSize="15"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"/>

                    <Border Grid.Column="4"
                            CornerRadius="9"
                            Padding="11,6"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Surface2Brush}">

                        <TextBlock Text="{Binding PaymentName}"
                                   FontSize="13"
                                   FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCredit}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <TextBlock Grid.Column="5"
                               Text="{Binding TotalAmount, StringFormat={}{0:N2}}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               Foreground="{DynamicResource TextBrush}"/>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- ============ Позиция в ленте чека ============ -->
        <DataTemplate DataType="{x:Type vm:ReceiptLineItem}">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="{Binding ProductName}"
                               FontSize="15"
                               Foreground="{DynamicResource TextBrush}"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="{Binding QuantityText}"
                               FontSize="13"
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding Total, StringFormat={}{0:N2}}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}"/>
            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Список ============ -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,16">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Фильтры -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="240"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="ПОИСК" Style="{StaticResource FieldCaption}"/>

                        <Grid>
                            <TextBox Style="{StaticResource Field}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"/>

                            <TextBlock Text="Номер чека, кассир, клиент или товар"
                                       Margin="15,0,0,0"
                                       FontSize="15"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedBrush}"
                                       Visibility="{Binding SearchText, Converter={StaticResource EmptyToVisibility}}"/>

                            <Button Style="{StaticResource MiniIconButton}"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,8,0"
                                    ToolTip="Очистить поиск"
                                    Command="{Binding ClearSearchCommand}"
                                    Visibility="{Binding HasSearch, Converter={StaticResource BoolToVisibility}}">

                                <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="С ДАТЫ" Style="{StaticResource FieldCaption}"/>
                        <DatePicker Style="{StaticResource FieldDate}" Width="170" SelectedDate="{Binding From, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock Text="ПО ДАТУ" Style="{StaticResource FieldCaption}"/>
                        <DatePicker Style="{StaticResource FieldDate}" Width="170" SelectedDate="{Binding To, Mode=TwoWay}"/>
                    </StackPanel>

                    <Button Grid.Column="3"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,20,0,0"
                            VerticalAlignment="Top"
                            Content="Показать"
                            Command="{Binding RefreshCommand}"/>
                </Grid>

                <!-- Быстрые периоды -->
                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <RadioButton Style="{StaticResource PeriodChip}"
                                     Content="Сегодня"
                                     IsChecked="{Binding IsToday, Mode=OneWay}"
                                     Command="{Binding SetPeriodCommand}"
                                     CommandParameter="Today"/>

                        <RadioButton Style="{StaticResource PeriodChip}"
                                     Content="Неделя"
                                     IsChecked="{Binding IsWeek, Mode=OneWay}"
                                     Command="{Binding SetPeriodCommand}"
                                     CommandParameter="Week"/>

                        <RadioButton Style="{StaticResource PeriodChip}"
                                     Content="Месяц"
                                     IsChecked="{Binding IsMonth, Mode=OneWay}"
                                     Command="{Binding SetPeriodCommand}"
                                     CommandParameter="Month"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Style="{StaticResource Muted}"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Text="{Binding SummaryText}"/>
                </Grid>

                <!-- Шапка таблицы -->
                <Grid Grid.Row="2" Margin="14,16,14,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*" MinWidth="160"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="ЧЕК" Style="{StaticResource FieldCaption}"/>
                    <TextBlock Grid.Column="1" Text="ВРЕМЯ" Style="{StaticResource FieldCaption}"/>
                    <TextBlock Grid.Column="2" Text="КАССИР / КЛИЕНТ" Style="{StaticResource FieldCaption}"/>
                    <TextBlock Grid.Column="3" Text="ПОЗИЦИЙ" Style="{StaticResource FieldCaption}" TextAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="ОПЛАТА" Style="{StaticResource FieldCaption}"/>
                    <TextBlock Grid.Column="5" Text="СУММА" Style="{StaticResource FieldCaption}" TextAlignment="Right" Margin="0,0,12,7"/>
                </Grid>

                <!-- Строки -->
                <Grid Grid.Row="3">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,6,0">

                        <ItemsControl ItemsSource="{Binding Receipts}"/>
                    </ScrollViewer>

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">

                        <materialDesign:PackIcon Kind="ReceiptTextOutline"
                                                 Width="46"
                                                 Height="46"
                                                 HorizontalAlignment="Center"
                                                 Foreground="{DynamicResource LineBrush}"/>

                        <TextBlock Text="За этот период чеков нет"
                                   Margin="0,10,0,0"
                                   FontSize="15"
                                   Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>

                    <TextBlock VerticalAlignment="Top"
                               Margin="14,4,0,0"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DangerBrush}"
                               Text="{Binding ErrorMessage}"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ============ Просмотр чека ============ -->
        <Border Grid.Column="1"
                Width="430"
                Margin="18,0,0,0"
                Style="{StaticResource Card}"
                Padding="18,16"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">

            <Grid DataContext="{Binding Selected}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Шапка -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="{Binding Number}" Style="{StaticResource SectionTitle}"/>

                        <TextBlock Text="{Binding SubTitle}"
                                   FontSize="14"
                                   Margin="0,2,0,0"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource MiniIconButton}"
                            VerticalAlignment="Top"
                            ToolTip="Закрыть"
                            Command="{Binding DataContext.CloseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">

                        <materialDesign:PackIcon Kind="Close" Width="17" Height="17"/>
                    </Button>
                </Grid>

                <!-- Лента чека -->
                <Border Grid.Row="1"
                        CornerRadius="13"
                        Padding="16"
                        Background="{DynamicResource Surface2Brush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <TextBlock Text="Мой склад"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextBrush}"/>

                            <TextBlock Text="г. Бишкек · ИНН 01234567890123"
                                       FontSize="13"
                                       Margin="0,2,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource MutedBrush}"/>

                            <Border Height="1" Margin="0,14" Background="{DynamicResource LineBrush}"/>

                            <ItemsControl ItemsSource="{Binding Lines}"/>

                            <Border Height="1" Margin="0,4,0,14" Background="{DynamicResource LineBrush}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Сумма" FontSize="15" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Subtotal, StringFormat={}{0:N2}}"
                                           FontSize="15"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </Grid>

                            <Grid Margin="0,8,0,0" Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding DiscountLabel}"
                                           FontSize="15"
                                           Foreground="{DynamicResource DangerBrush}"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding DiscountAmount, StringFormat=− {0:N2}}"
                                           FontSize="15"
                                           Foreground="{DynamicResource DangerBrush}"/>
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Итого"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextBrush}"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding TotalAmount, StringFormat={}{0:N2}}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding PaymentName}"
                                           FontSize="15"
                                           Foreground="{DynamicResource MutedBrush}"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding PaidAmount, StringFormat={}{0:N2}}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SuccessBrush}"/>
                            </Grid>

                            <Grid Margin="0,8,0,0" Visibility="{Binding IsCredit, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding CustomerName, StringFormat=Долг · {0}}"
                                           FontSize="15"
                                           Foreground="{DynamicResource MutedBrush}"
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding DebtLeft, StringFormat={}{0:N2}}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource DangerBrush}"/>
                            </Grid>

                            <TextBlock Text="Рахмат! Спасибо за покупку"
                                       FontSize="13"
                                       Margin="0,18,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource MutedBrush}"/>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
