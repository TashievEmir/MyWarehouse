<UserControl x:Class="Wpf.Views.Products.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:common="clr-namespace:Wpf.Common"
             xmlns:vm="clr-namespace:Wpf.ViewModels.Products"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <common:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <common:EmptyStringToVisibilityConverter x:Key="EmptyToVisibility"/>

        <!-- ============ Строка сканирования ============ -->
        <DataTemplate DataType="{x:Type vm:ScannedProductItem}">
            <Border Margin="0,0,0,6"
                    CornerRadius="10"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    Padding="10,8">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Barcode"/>
                        <ColumnDefinition Width="*" MinWidth="150"/>
                        <ColumnDefinition Width="215"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Qty"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Remove"/>
                    </Grid.ColumnDefinitions>

                    <!-- Штрихкод -->
                    <Border Grid.Column="0"
                            CornerRadius="8"
                            Padding="8,5"
                            VerticalAlignment="Center"
                            Background="{StaticResource CanvasBrush}">

                        <TextBlock Text="{Binding Barcode}"
                                   FontSize="12"
                                   FontFamily="Consolas"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>

                    <!-- Название: у известного товара только читаем -->
                    <Grid Grid.Column="1" Margin="10,0">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">

                            <TextBlock Text="{Binding Name}"
                                       FontSize="13"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>

                            <TextBlock Style="{StaticResource Muted}"
                                       FontSize="11"
                                       Margin="8,1,0,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding InStockBefore, StringFormat=на складе: {0}}"/>
                        </StackPanel>

                        <Grid Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}">
                            <TextBox x:Name="NameBox"
                                     Style="{StaticResource Field}"
                                     Height="32"
                                     KeyDown="OnScanFieldKeyDown"
                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Название нового товара"
                                       FontSize="12"
                                       Margin="12,0,0,0"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Visibility="{Binding Name, Converter={StaticResource EmptyToVisibility}}"/>
                        </Grid>
                    </Grid>

                    <!-- Категория -->
                    <Grid Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="{Binding CategoryName}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>

                        <Grid Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}">

                            <ComboBox Style="{StaticResource FieldCombo}"
                                      Height="32"
                                      FontSize="12"
                                      Tag="Категория"
                                      ItemsSource="{Binding DataContext.CategoryOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                      Visibility="{Binding IsCreatingCategory, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">

                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCreateNew}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource BrandBrush}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Ввод названия новой категории -->
                            <Grid Visibility="{Binding IsCreatingCategory, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <TextBox Style="{StaticResource Field}"
                                             Height="32"
                                             FontSize="12"
                                             IsVisibleChanged="OnCategoryEditorVisible"
                                             Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}">

                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter"
                                                        Command="{Binding DataContext.CreateCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            <KeyBinding Key="Escape" Command="{Binding CancelNewCategoryCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>

                                    <TextBlock Text="Название категории"
                                               FontSize="12"
                                               Margin="12,0,0,0"
                                               IsHitTestVisible="False"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Visibility="{Binding NewCategoryName, Converter={StaticResource EmptyToVisibility}}"/>
                                </Grid>

                                <Button Grid.Column="1"
                                        Style="{StaticResource MiniIconButton}"
                                        Margin="2,0,0,0"
                                        ToolTip="Создать категорию"
                                        Command="{Binding DataContext.CreateCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">

                                    <materialDesign:PackIcon Kind="Check" Width="16" Height="16"/>
                                </Button>

                                <Button Grid.Column="2"
                                        Style="{StaticResource MiniIconButton}"
                                        ToolTip="Отменить"
                                        Command="{Binding CancelNewCategoryCommand}">

                                    <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                                </Button>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- Количество -->
                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Button Style="{StaticResource MiniIconButton}"
                                Command="{Binding DecreaseCommand}"
                                ToolTip="Убавить">
                            <materialDesign:PackIcon Kind="Minus" Width="16" Height="16"/>
                        </Button>

                        <TextBox Style="{StaticResource Field}"
                                 Width="52"
                                 Height="32"
                                 Margin="4,0"
                                 Padding="0"
                                 TextAlignment="Center"
                                 FontWeight="SemiBold"
                                 KeyDown="OnScanFieldKeyDown"
                                 Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"/>

                        <Button Style="{StaticResource MiniIconButton}"
                                Command="{Binding IncreaseCommand}"
                                ToolTip="Добавить">
                            <materialDesign:PackIcon Kind="Plus" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>

                    <!-- Цена закупки -->
                    <TextBox Grid.Column="4"
                             Style="{StaticResource Field}"
                             Height="32"
                             Margin="10,0,6,0"
                             TextAlignment="Right"
                             KeyDown="OnScanFieldKeyDown"
                             ToolTip="Цена закупки за штуку"
                             Text="{Binding Cost, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Цена продажи: уедет в карточку товара и на кассу -->
                    <TextBox Grid.Column="5"
                             Style="{StaticResource Field}"
                             Height="32"
                             Margin="0,0,10,0"
                             TextAlignment="Right"
                             FontWeight="SemiBold"
                             KeyDown="OnScanFieldKeyDown"
                             ToolTip="Цена продажи за штуку — подставится на кассе"
                             Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"/>

                    <Button Grid.Column="6"
                            Style="{StaticResource MiniIconButton}"
                            VerticalAlignment="Center"
                            ToolTip="Убрать из списка"
                            Command="{Binding DataContext.RemoveScannedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">

                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <!-- ============ Приход по штрихкоду ============ -->
    <Border Style="{StaticResource Card}" Padding="16,14">

        <Grid Grid.IsSharedSizeScope="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок панели -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="BarcodeScan"
                                             Width="20"
                                             Height="20"
                                             VerticalAlignment="Center"
                                             Foreground="{StaticResource BrandBrush}"/>

                    <TextBlock Text="Приход по штрихкоду"
                               Style="{StaticResource SectionTitle}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>

                    <TextBlock Style="{StaticResource Muted}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Text="{Binding ScannedSummary}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Поставщик"
                               Style="{StaticResource Muted}"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"/>

                    <TextBox Style="{StaticResource Field}"
                             Width="220"
                             Height="32"
                             Text="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>

            <!-- Поле сканера -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox x:Name="BarcodeBox"
                             Style="{StaticResource Field}"
                             FontSize="14"
                             Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ScanCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <TextBlock Text="Отсканируйте штрихкод — товар добавится в список"
                               Margin="13,0,0,0"
                               FontSize="13"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Visibility="{Binding BarcodeInput, Converter={StaticResource EmptyToVisibility}}"/>
                </Grid>

                <Button Grid.Column="1"
                        Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0"
                        Content="Считать"
                        Click="OnReturnFocusToScanner"
                        Command="{Binding ScanCommand}"/>
            </Grid>

            <!-- Шапка списка -->
            <Grid Grid.Row="2"
                  Margin="10,2,10,4"
                  Visibility="{Binding HasScanned, Converter={StaticResource BoolToVisibility}}">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Barcode"/>
                    <ColumnDefinition Width="*" MinWidth="150"/>
                    <ColumnDefinition Width="215"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Qty"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Remove"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="1" Text="ТОВАР" Style="{StaticResource FieldCaption}" Margin="10,0,0,5"/>
                <TextBlock Grid.Column="2" Text="КАТЕГОРИЯ" Style="{StaticResource FieldCaption}" Margin="0,0,0,5"/>
                <TextBlock Grid.Column="3" Text="КОЛ-ВО" Style="{StaticResource FieldCaption}" TextAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Grid.Column="4" Text="ЗАКУПКА" Style="{StaticResource FieldCaption}" TextAlignment="Right" Margin="10,0,6,5"/>
                <TextBlock Grid.Column="5" Text="ПРОДАЖА" Style="{StaticResource FieldCaption}" TextAlignment="Right" Margin="0,0,10,5"/>
            </Grid>

            <!-- Список считанных -->
            <Grid Grid.Row="3">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,6,0">

                    <ItemsControl ItemsSource="{Binding Scanned}"/>
                </ScrollViewer>

                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="{Binding HasScanned, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">

                    <materialDesign:PackIcon Kind="BarcodeScan"
                                             Width="44"
                                             Height="44"
                                             HorizontalAlignment="Center"
                                             Foreground="{StaticResource LineBrush}"/>

                    <TextBlock Text="Отсканируйте товары — они появятся здесь"
                               Margin="0,10,0,0"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Grid>

            <!-- Подвал панели -->
            <Grid Grid.Row="4" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding StatusMessage}"
                           Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">

                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0"
                            Content="Очистить"
                            IsEnabled="{Binding HasScanned}"
                            Click="OnReturnFocusToScanner"
                            Command="{Binding ClearScannedCommand}"/>

                    <Button Style="{StaticResource PrimaryButton}"
                            IsEnabled="{Binding CanSave}"
                            Click="OnReturnFocusToScanner"
                            Command="{Binding SaveCommand}">

                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSaveOutline"
                                                     Width="17"
                                                     Height="17"
                                                     VerticalAlignment="Center"/>

                            <TextBlock Text="Добавить товары"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</UserControl>
