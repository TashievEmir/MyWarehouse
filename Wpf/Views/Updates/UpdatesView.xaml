<UserControl x:Class="Wpf.Views.Updates.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:common="clr-namespace:Wpf.Common"
             xmlns:loc="clr-namespace:Wpf.Localization"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1200"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <common:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid>
        <Border Style="{StaticResource Card}"
                Padding="22,20"
                Width="620"
                VerticalAlignment="Top"
                HorizontalAlignment="Left">

            <StackPanel>

                <TextBlock Text="{loc:Tr Updates_Title}" Style="{StaticResource SectionTitle}"/>

                <TextBlock Text="{loc:Tr Updates_Subtitle}"
                           FontSize="14"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedBrush}"/>

                <!-- Что установлено сейчас -->
                <Border Margin="0,18,0,0"
                        Padding="16,14"
                        CornerRadius="10"
                        Background="{DynamicResource Surface2Brush}">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:Tr Updates_Installed}"
                                       Style="{StaticResource Muted}"
                                       FontSize="13"/>

                            <TextBlock Text="{Binding CurrentVersion}"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>

                        <materialDesign:PackIcon Grid.Column="1"
                                                 Kind="CheckDecagram"
                                                 Width="30"
                                                 Height="30"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource SuccessBrush}"
                                                 Visibility="{Binding IsUpToDate, Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>
                </Border>

                <!-- Найденный выпуск -->
                <Border Margin="0,12,0,0"
                        Padding="16,14"
                        CornerRadius="10"
                        Background="{DynamicResource Surface2Brush}"
                        BorderBrush="{DynamicResource PrimaryBrush}"
                        BorderThickness="1"
                        Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibility}}">

                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{loc:Tr Updates_Available}"
                                           Style="{StaticResource Muted}"
                                           FontSize="13"/>

                                <TextBlock Text="{Binding AvailableVersion}"
                                           FontSize="26"
                                           FontWeight="SemiBold"
                                           Margin="0,2,0,0"
                                           Foreground="{DynamicResource PrimaryBrush}"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding SizeText}"
                                       Style="{StaticResource Muted}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding HasSize, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>

                        <TextBlock Text="{loc:Tr Updates_Notes}"
                                   Style="{StaticResource Muted}"
                                   FontSize="12"
                                   Margin="0,14,0,5"
                                   Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}"/>

                        <TextBlock Text="{Binding Notes}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextBrush}"
                                   Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </Border>

                <!-- Данные при обновлении не теряются -->
                <Border Margin="0,12,0,0"
                        Padding="12,10"
                        CornerRadius="10"
                        Background="{DynamicResource Surface2Brush}"
                        Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibility}}">

                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ShieldCheckOutline"
                                                 Width="17"
                                                 Height="17"
                                                 Margin="0,0,9,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource SuccessBrush}"/>

                        <TextBlock Text="{loc:Tr Updates_DataSafe}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   MaxWidth="520"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Ход установки -->
                <StackPanel Margin="0,16,0,0"
                            Visibility="{Binding HasStage, Converter={StaticResource BoolToVisibility}}">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding StageText}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextBrush}"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Percent, StringFormat={}{0}%}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   Visibility="{Binding IsPercentKnown, Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>

                    <ProgressBar Height="6"
                                 Margin="0,7,0,0"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding Percent}"
                                 IsIndeterminate="{Binding IsPercentUnknown}"
                                 Foreground="{DynamicResource PrimaryBrush}"
                                 Background="{DynamicResource LineBrush}"/>
                </StackPanel>

                <!-- Кнопки -->
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource SecondaryButton}"
                            Height="50"
                            FontSize="15"
                            Margin="0,0,6,0"
                            IsEnabled="{Binding CanCheck}"
                            Command="{Binding CheckCommand}">

                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CloudSearchOutline" Width="20" Height="20" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr Updates_Check}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1"
                            Style="{StaticResource PrimaryButton}"
                            Height="50"
                            FontSize="15"
                            Margin="6,0,0,0"
                            IsEnabled="{Binding CanInstall}"
                            Command="{Binding InstallCommand}"
                            Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibility}}">

                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Download" Width="20" Height="20" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr Updates_Install}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock Margin="0,16,0,0"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Text="{Binding StatusMessage}"
                           Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">

                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="{Binding InstallDirectory}"
                           Style="{StaticResource Muted}"
                           FontSize="11"
                           Margin="0,16,0,0"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding InstallDirectory}"/>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
