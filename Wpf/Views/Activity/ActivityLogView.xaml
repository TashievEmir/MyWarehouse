<UserControl x:Class="Wpf.Views.Activity.ActivityLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:common="clr-namespace:Wpf.Common"
             xmlns:loc="clr-namespace:Wpf.Localization"
             xmlns:vm="clr-namespace:Wpf.ViewModels.Activity"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1200"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <common:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <common:EmptyStringToVisibilityConverter x:Key="EmptyToVisibility"/>
        <common:ResourceKeyToBrushConverter x:Key="KeyToBrush"/>

        <!-- ============ Событие ============ -->
        <DataTemplate DataType="{x:Type vm:ActivityEntryItem}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="74"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding TimeText}"
                           FontSize="15"
                           Margin="0,14,0,0"
                           TextAlignment="Right"
                           Foreground="{DynamicResource MutedBrush}"/>

                <!-- Линия таймлайна с точкой события -->
                <Grid Grid.Column="1" Width="16" Margin="16,0">
                    <Border Width="2" HorizontalAlignment="Center" Background="{DynamicResource LineBrush}"/>

                    <Ellipse Width="14"
                             Height="14"
                             VerticalAlignment="Top"
                             HorizontalAlignment="Center"
                             Margin="0,18,0,0"
                             StrokeThickness="3"
                             Stroke="{DynamicResource SurfaceBrush}"
                             Fill="{Binding ColorKey, Converter={StaticResource KeyToBrush}}"/>
                </Grid>

                <Border Grid.Column="2"
                        Margin="0,0,0,10"
                        Padding="14,12"
                        CornerRadius="13"
                        Background="{DynamicResource Surface2Brush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1">

                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <materialDesign:PackIcon Grid.Column="0"
                                                     Kind="{Binding Icon}"
                                                     Width="20"
                                                     Height="20"
                                                     VerticalAlignment="Center"
                                                     Foreground="{Binding ColorKey, Converter={StaticResource KeyToBrush}}"/>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Title}"
                                       Margin="10,0,10,0"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextBrush}"
                                       TextTrimming="CharacterEllipsis"/>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding UserName}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedBrush}"/>
                        </Grid>

                        <TextBlock Text="{Binding Details}"
                                   Margin="30,4,0,0"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ Фильтры ============ -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,18">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="260"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="{loc:Tr Common_Search}" Style="{StaticResource FieldCaption}"/>

                    <Grid>
                        <TextBox Style="{StaticResource Field}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"/>

                        <TextBlock Text="{loc:Tr Activity_SearchHint}"
                                   Margin="15,0,0,0"
                                   FontSize="15"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Visibility="{Binding SearchText, Converter={StaticResource EmptyToVisibility}}"/>

                        <Button Style="{StaticResource MiniIconButton}"
                                HorizontalAlignment="Right"
                                Margin="0,0,8,0"
                                ToolTip="{loc:Tr Common_ClearSearch}"
                                Command="{Binding ClearSearchCommand}"
                                Visibility="{Binding HasSearch, Converter={StaticResource BoolToVisibility}}">

                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                    <TextBlock Text="{loc:Tr Activity_User}" Style="{StaticResource FieldCaption}"/>

                    <ComboBox Style="{StaticResource FieldCombo}"
                              Width="210"
                              Tag="{loc:Tr Activity_AllUsers}"
                              ItemsSource="{Binding Users}"
                              SelectedItem="{Binding SelectedUser, Mode=TwoWay}">

                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding UserName}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,14,0">
                    <TextBlock Text="{loc:Tr Common_DateFrom}" Style="{StaticResource FieldCaption}"/>
                    <DatePicker Style="{StaticResource FieldDate}" Width="170" SelectedDate="{Binding From, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,14,0">
                    <TextBlock Text="{loc:Tr Common_DateTo}" Style="{StaticResource FieldCaption}"/>
                    <DatePicker Style="{StaticResource FieldDate}" Width="170" SelectedDate="{Binding To, Mode=TwoWay}"/>
                </StackPanel>

                <Button Grid.Column="4"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,20,0,0"
                        VerticalAlignment="Top"
                        Content="{loc:Tr Common_Show}"
                        Command="{Binding RefreshCommand}"/>
            </Grid>
        </Border>

        <!-- ============ Таймлайн ============ -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,16">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding PeriodTitle}" Style="{StaticResource BlockTitle}"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding CountText}"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"/>
                </Grid>

                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,6,0">

                        <ItemsControl ItemsSource="{Binding Entries}"/>
                    </ScrollViewer>

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">

                        <materialDesign:PackIcon Kind="History"
                                                 Width="46"
                                                 Height="46"
                                                 HorizontalAlignment="Center"
                                                 Foreground="{DynamicResource LineBrush}"/>

                        <TextBlock Text="{loc:Tr Activity_Empty}"
                                   Margin="0,10,0,0"
                                   FontSize="15"
                                   Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>

                    <TextBlock VerticalAlignment="Top"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DangerBrush}"
                               Text="{Binding ErrorMessage}"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
