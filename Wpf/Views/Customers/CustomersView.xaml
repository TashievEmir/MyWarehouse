<UserControl x:Class="Wpf.Views.Customers.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:common="clr-namespace:Wpf.Common"
             xmlns:loc="clr-namespace:Wpf.Localization"
             xmlns:vm="clr-namespace:Wpf.ViewModels.Customers"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1200"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <common:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <common:EmptyStringToVisibilityConverter x:Key="EmptyToVisibility"/>

        <!-- Строка списка -->
        <Style x:Key="CustomerRow" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Margin="0,0,0,6"
                                Padding="12,10"
                                CornerRadius="10"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1"
                                SnapsToDevicePixels="True">

                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Клиент в списке ============ -->
        <DataTemplate DataType="{x:Type vm:CustomerListItem}">
            <Button Style="{StaticResource CustomerRow}"
                    Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>

                        <!-- Заметка целиком уходит в подсказку: в строке для неё нет места -->
                        <materialDesign:PackIcon Kind="NoteTextOutline"
                                                 Width="14"
                                                 Height="14"
                                                 Margin="7,0,0,0"
                                                 VerticalAlignment="Center"
                                                 ToolTip="{Binding Note}"
                                                 Foreground="{DynamicResource PrimaryBrush}"
                                                 Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{Binding PhoneText}"
                               Style="{StaticResource Muted}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Без почты клиент выпадает из рассылки — помечаем -->
                        <materialDesign:PackIcon Kind="EmailOffOutline"
                                                 Width="14"
                                                 Height="14"
                                                 Margin="0,0,5,0"
                                                 VerticalAlignment="Center"
                                                 ToolTip="{loc:Tr Customers_NoEmailTip}"
                                                 Foreground="{DynamicResource WarningBrush}">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="materialDesign:PackIcon">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasEmail}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>

                        <TextBlock Text="{Binding EmailText}"
                                   Style="{StaticResource Muted}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Border Grid.Column="3"
                            CornerRadius="8"
                            Padding="9,4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="{DynamicResource CanvasBrush}"
                            Visibility="{Binding HasDebt, Converter={StaticResource BoolToVisibility}}">

                        <TextBlock Text="{Binding DebtText}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource DangerBrush}"/>
                    </Border>
                </Grid>
            </Button>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Список ============ -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16,14">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Поиск и создание -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <TextBox Style="{StaticResource Field}"
                                 FontSize="14"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"/>

                        <TextBlock Text="{loc:Tr Customers_SearchHint}"
                                   Margin="13,0,0,0"
                                   FontSize="13"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding SearchText, Converter={StaticResource EmptyToVisibility}}"/>

                        <Button Style="{StaticResource MiniIconButton}"
                                HorizontalAlignment="Right"
                                Margin="0,0,6,0"
                                ToolTip="{loc:Tr Common_ClearSearch}"
                                Command="{Binding ClearSearchCommand}"
                                Visibility="{Binding HasSearch, Converter={StaticResource BoolToVisibility}}">

                            <materialDesign:PackIcon Kind="Close" Width="15" Height="15"/>
                        </Button>
                    </Grid>

                    <TextBlock Grid.Column="1"
                               Style="{StaticResource Muted}"
                               Margin="12,0,12,0"
                               VerticalAlignment="Center"
                               Text="{Binding CountText}"/>

                    <Button Grid.Column="2"
                            Style="{StaticResource PrimaryButton}"
                            Height="44"
                            Padding="16,0"
                            Command="{Binding NewCommand}">

                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountPlusOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr Customers_New}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Сколько клиентов не получат писем -->
                <Border Grid.Row="1"
                        Margin="0,0,0,12"
                        Padding="12,9"
                        CornerRadius="10"
                        Background="{DynamicResource Surface2Brush}"
                        Visibility="{Binding HasNoEmailHint, Converter={StaticResource BoolToVisibility}}">

                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="InformationOutline"
                                                 Width="16"
                                                 Height="16"
                                                 Margin="0,0,9,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource WarningBrush}"/>

                        <TextBlock Text="{Binding NoEmailHint}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <ItemsControl ItemsSource="{Binding Items}"/>
                    </ScrollViewer>

                    <TextBlock Text="{loc:Tr Customers_Empty}"
                               Style="{StaticResource Muted}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="420"
                               TextAlignment="Center"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ============ Карточка ============ -->
        <Border Grid.Column="1"
                Width="380"
                Margin="18,0,0,0"
                Style="{StaticResource Card}"
                Padding="18,16"
                Visibility="{Binding HasEditor, Converter={StaticResource BoolToVisibility}}">

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding EditorTitle}"
                                   Style="{StaticResource FieldCaption}"
                                   TextTrimming="CharacterEllipsis"/>

                        <Button Grid.Column="1"
                                Style="{StaticResource MiniIconButton}"
                                Width="28"
                                Height="28"
                                ToolTip="{loc:Tr Common_Close}"
                                Command="{Binding CloseCommand}">

                            <materialDesign:PackIcon Kind="Close" Width="15" Height="15"/>
                        </Button>
                    </Grid>

                    <!-- Долг: справочно, гасится в разделе «Долги» -->
                    <Border Margin="0,14,0,0"
                            Padding="12,10"
                            CornerRadius="10"
                            Background="{DynamicResource Surface2Brush}"
                            Visibility="{Binding HasEditedDebt, Converter={StaticResource BoolToVisibility}}">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{loc:Tr Customers_Debt}"
                                       Style="{StaticResource Muted}"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding EditedDebtText}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource DangerBrush}"/>
                        </Grid>
                    </Border>

                    <!-- Дата регистрации: хранится в базе, но не правится -->
                    <TextBlock Text="{Binding CreatedAtText}"
                               Style="{StaticResource Muted}"
                               FontSize="12"
                               Margin="2,12,0,0"
                               Visibility="{Binding HasCreatedAt, Converter={StaticResource BoolToVisibility}}"/>

                    <TextBlock Text="{loc:Tr Customers_Name}" Style="{StaticResource Muted}" Margin="2,16,0,7"/>
                    <TextBox Style="{StaticResource Field}"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="{loc:Tr Customers_Phone}" Style="{StaticResource Muted}" Margin="2,14,0,7"/>
                    <TextBox Style="{StaticResource Field}"
                             Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="{loc:Tr Customers_Email}" Style="{StaticResource Muted}" Margin="2,14,0,7"/>
                    <TextBox Style="{StaticResource Field}"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="{loc:Tr Customers_EmailHint}"
                               Style="{StaticResource Muted}"
                               FontSize="12"
                               Margin="2,7,0,0"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="{loc:Tr Customers_Address}" Style="{StaticResource Muted}" Margin="2,14,0,7"/>
                    <TextBox Style="{StaticResource Field}"
                             Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="{loc:Tr Customers_Note}" Style="{StaticResource Muted}" Margin="2,14,0,7"/>

                    <!-- Заметка многострочная: «звонить после обеда», «платит с задержкой» -->
                    <TextBox Style="{StaticResource Field}"
                             Height="76"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/>

                    <Button Style="{StaticResource PrimaryButton}"
                            Height="48"
                            FontSize="15"
                            Margin="0,20,0,0"
                            IsEnabled="{Binding CanSave}"
                            Command="{Binding SaveCommand}">

                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSaveOutline" Width="19" Height="19" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr Common_Save}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SecondaryButton}"
                            Height="44"
                            Margin="0,10,0,0"
                            Content="{loc:Tr Common_Delete}"
                            Foreground="{DynamicResource DangerBrush}"
                            IsEnabled="{Binding CanDelete}"
                            Command="{Binding DeleteCommand}"
                            Visibility="{Binding IsExisting, Converter={StaticResource BoolToVisibility}}"/>

                    <TextBlock Text="{Binding DeleteHint}"
                               Style="{StaticResource Muted}"
                               FontSize="12"
                               Margin="2,7,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding IsExisting, Converter={StaticResource BoolToVisibility}}"/>

                    <TextBlock Margin="0,14,0,0"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Text="{Binding StatusMessage}"
                               Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
