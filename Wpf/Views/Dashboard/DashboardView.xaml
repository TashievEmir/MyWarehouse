<UserControl x:Class="Wpf.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:common="clr-namespace:Wpf.Common"
             xmlns:vm="clr-namespace:Wpf.ViewModels.Dashboard"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1200"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <common:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="KpiCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>

        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="KpiHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>

        <!-- ============ Столбик графика ============ -->
        <DataTemplate DataType="{x:Type vm:RevenueBarItem}">
            <Grid Margin="3,0" ToolTip="{Binding Tooltip}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding AmountLabel}"
                               FontSize="10"
                               Margin="0,0,0,4"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"/>

                    <Border x:Name="Bar"
                            Height="{Binding BarHeight}"
                            CornerRadius="6,6,0,0"
                            Background="{StaticResource BrandLightBrush}"/>
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Text="{Binding DayLabel}"
                           FontSize="10"
                           Margin="0,6,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter TargetName="Bar" Property="Background" Value="{StaticResource BrandBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ============ Способ оплаты ============ -->
        <DataTemplate DataType="{x:Type vm:PaymentSliceItem}">
            <StackPanel Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="13"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>

                        <TextBlock Text="{Binding ReceiptsLabel}"
                                   Style="{StaticResource Muted}"
                                   FontSize="11"
                                   Margin="8,1,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{Binding Amount, StringFormat={}{0:N2}}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </Grid>

                <ProgressBar Height="5"
                             Margin="0,6,0,0"
                             Minimum="0"
                             Maximum="100"
                             BorderThickness="0"
                             Background="{StaticResource CanvasBrush}"
                             Foreground="{StaticResource BrandBrush}"
                             Value="{Binding SharePercent, Mode=OneWay}"/>
            </StackPanel>
        </DataTemplate>

        <!-- ============ Заканчивается ============ -->
        <DataTemplate DataType="{x:Type vm:LowStockItem}">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="{Binding Name}"
                               FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"/>

                    <TextBlock Text="{Binding CategoryName}"
                               Style="{StaticResource Muted}"
                               FontSize="11"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        CornerRadius="8"
                        Padding="9,4"
                        VerticalAlignment="Center"
                        Background="{StaticResource CanvasBrush}">

                    <TextBlock Text="{Binding StockLabel}"
                               FontSize="12"
                               FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOut}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ============ Топ товаров ============ -->
        <DataTemplate DataType="{x:Type vm:TopProductItem}">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="24"
                        Height="24"
                        CornerRadius="12"
                        VerticalAlignment="Center"
                        Background="{StaticResource BrandSoftBrush}">

                    <TextBlock Text="{Binding Position}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource BrandBrush}"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"/>

                    <TextBlock Text="{Binding QuantityLabel}"
                               Style="{StaticResource Muted}"
                               FontSize="11"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="{Binding Revenue, StringFormat={}{0:N2}}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel>

            <!-- ============ Шапка ============ -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Greeting}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>

                    <TextBlock Text="{Binding TodayLabel}"
                               Style="{StaticResource Muted}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource SecondaryButton}"
                        VerticalAlignment="Center"
                        Command="{Binding RefreshCommand}">

                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Width="17" Height="17" VerticalAlignment="Center"/>
                        <TextBlock Text="Обновить" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Товары без цены мешают продавать — говорим об этом сразу -->
            <Border Style="{StaticResource Card}"
                    Padding="14,10"
                    Margin="0,0,0,14"
                    BorderBrush="{StaticResource DangerBrush}"
                    Visibility="{Binding HasPriceWarning, Converter={StaticResource BoolToVisibility}}">

                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AlertCircleOutline"
                                             Width="19"
                                             Height="19"
                                             VerticalAlignment="Center"
                                             Foreground="{StaticResource DangerBrush}"/>

                    <TextBlock Text="{Binding PriceWarningText}"
                               Margin="10,0,0,0"
                               FontSize="13"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>

            <TextBlock Margin="2,0,0,10"
                       FontSize="12"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource DangerBrush}"
                       Text="{Binding ErrorMessage}"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>

            <!-- ============ Показатели дня ============ -->
            <UniformGrid Columns="4" Margin="0,0,0,14">

                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,7,0">
                    <StackPanel>
                        <TextBlock Text="ВЫРУЧКА ЗА СЕГОДНЯ" Style="{StaticResource KpiCaption}"/>
                        <TextBlock Text="{Binding TodayRevenue, StringFormat={}{0:N2}}" Style="{StaticResource KpiValue}"/>
                        <TextBlock Style="{StaticResource KpiHint}"
                                   Text="{Binding TodayReceipts, StringFormat=чеков: {0}}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16,14" Margin="7,0">
                    <StackPanel>
                        <TextBlock Text="СРЕДНИЙ ЧЕК" Style="{StaticResource KpiCaption}"/>
                        <TextBlock Text="{Binding AverageReceipt, StringFormat={}{0:N2}}" Style="{StaticResource KpiValue}"/>
                        <TextBlock Style="{StaticResource KpiHint}"
                                   Text="{Binding TodayWrittenOff, StringFormat=списано сегодня: {0} шт.}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16,14" Margin="7,0">
                    <StackPanel>
                        <TextBlock Text="ПРИБЫЛЬ ЗА СЕГОДНЯ" Style="{StaticResource KpiCaption}"/>

                        <TextBlock Text="{Binding TodayProfit, StringFormat={}{0:N2}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource KpiValue}">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProfitPositive}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Style="{StaticResource KpiHint}"
                                   Text="{Binding TodayPurchases, StringFormat=закуплено на: {0:N2}}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16,14" Margin="7,0,0,0">
                    <StackPanel>
                        <TextBlock Text="ДОЛГ КЛИЕНТОВ" Style="{StaticResource KpiCaption}"/>

                        <TextBlock Text="{Binding TotalDebt, StringFormat={}{0:N2}}"
                                   Style="{StaticResource KpiValue}"
                                   Foreground="{StaticResource DangerBrush}"/>

                        <TextBlock Style="{StaticResource KpiHint}" Text="{Binding DebtorsLabel}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ============ График и оплаты ============ -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="{Binding RevenuePeriodLabel}" Style="{StaticResource SectionTitle}"/>

                        <ItemsControl ItemsSource="{Binding Revenue}" Margin="0,16,0,0" Height="170">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Width="360"
                        Margin="14,0,0,0"
                        Style="{StaticResource Card}"
                        Padding="18,16">

                    <StackPanel>
                        <TextBlock Text="Оплаты за сегодня" Style="{StaticResource SectionTitle}"/>

                        <ItemsControl ItemsSource="{Binding Payments}" Margin="0,16,0,0"/>

                        <StackPanel Margin="0,10,0,0"
                                    Visibility="{Binding HasSales, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">

                            <TextBlock Text="Сегодня продаж ещё не было"
                                       Style="{StaticResource Muted}"
                                       HorizontalAlignment="Center"
                                       Margin="0,20,0,20"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ Склад и топ ============ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,16" Margin="0,0,7,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding LowStockLabel}" Style="{StaticResource SectionTitle}"/>

                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource Muted}"
                                       VerticalAlignment="Center"
                                       Text="{Binding ProductsOutOfStock, StringFormat=нет в наличии: {0}}"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding LowStock}" Margin="0,16,0,0"/>

                        <TextBlock Text="Всё в достатке"
                                   Style="{StaticResource Muted}"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,20"
                                   Visibility="{Binding HasLowStock, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18,16" Margin="7,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding TopPeriodLabel}" Style="{StaticResource SectionTitle}"/>

                        <ItemsControl ItemsSource="{Binding TopProducts}" Margin="0,16,0,0"/>

                        <TextBlock Text="Продаж за период не было"
                                   Style="{StaticResource Muted}"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,20"
                                   Visibility="{Binding HasTopProducts, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
