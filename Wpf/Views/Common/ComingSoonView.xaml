<UserControl x:Class="Wpf.Views.Common.ComingSoonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:loc="clr-namespace:Wpf.Localization"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             FontFamily="Segoe UI">

    <Border Style="{StaticResource Card}" Padding="24">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <materialDesign:PackIcon Kind="ShapeOutline"
                                     Width="52"
                                     Height="52"
                                     HorizontalAlignment="Center"
                                     Foreground="{DynamicResource LineBrush}"/>

            <TextBlock Text="{loc:Tr Soon_Title}"
                       Margin="0,14,0,0"
                       FontSize="18"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextBrush}"/>

            <TextBlock Text="{loc:Tr Soon_Text}"
                       Margin="0,8,0,0"
                       FontSize="15"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}"/>

        </StackPanel>
    </Border>
</UserControl>
