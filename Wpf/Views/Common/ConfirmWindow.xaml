<Window x:Class="Wpf.Views.Common.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:common="clr-namespace:Wpf.Common"
        mc:Ignorable="d"
        d:DesignHeight="400" d:DesignWidth="700"
        FontFamily="Segoe UI"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <common:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <!-- Затемнение поверх окна: фокус уводится на вопрос -->
    <Grid Background="{DynamicResource OverlayBrush}">

        <Border Style="{StaticResource Card}"
                Width="460"
                Padding="26,24"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.35" Color="#000000"/>
            </Border.Effect>

            <StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Border Width="38"
                            Height="38"
                            CornerRadius="19"
                            Margin="0,0,13,0"
                            VerticalAlignment="Top"
                            Background="{Binding AccentSoftBrush, RelativeSource={RelativeSource AncestorType=Window}}">

                        <materialDesign:PackIcon Width="21"
                                                 Height="21"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Kind="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Foreground="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </Border>

                    <TextBlock Text="{Binding TitleText, RelativeSource={RelativeSource AncestorType=Window}}"
                               Style="{StaticResource SectionTitle}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               MaxWidth="340"/>
                </StackPanel>

                <TextBlock Text="{Binding Message, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontSize="14"
                           TextWrapping="Wrap"
                           LineHeight="21"
                           Foreground="{DynamicResource TextBrush}"/>

                <Grid Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="CancelButton"
                            Grid.Column="0"
                            Style="{StaticResource SecondaryButton}"
                            Height="46"
                            FontSize="14"
                            Margin="0,0,6,0"
                            IsCancel="True"
                            Content="{Binding CancelText, RelativeSource={RelativeSource AncestorType=Window}}"
                            Click="OnCancel"/>

                    <Button x:Name="ConfirmButton"
                            Grid.Column="1"
                            Style="{StaticResource PrimaryButton}"
                            Height="46"
                            FontSize="14"
                            Margin="6,0,0,0"
                            IsDefault="True"
                            Content="{Binding ConfirmText, RelativeSource={RelativeSource AncestorType=Window}}"
                            Click="OnConfirm"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
