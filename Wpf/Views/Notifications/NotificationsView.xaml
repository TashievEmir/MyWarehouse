<UserControl x:Class="Wpf.Views.Notifications.NotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:common="clr-namespace:Wpf.Common"
             xmlns:loc="clr-namespace:Wpf.Localization"
             xmlns:vm="clr-namespace:Wpf.ViewModels.Notifications"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1200"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <common:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- ============ Строка истории отправок ============ -->
        <DataTemplate DataType="{x:Type vm:ReminderLogItem}">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!-- Досрочную отправку отличаем от плановой -->
                    <materialDesign:PackIcon Kind="HandPointingRight"
                                             Width="14"
                                             Height="14"
                                             Margin="0,0,5,0"
                                             VerticalAlignment="Center"
                                             ToolTip="{loc:Tr Notif_LogManualTip}"
                                             Foreground="{DynamicResource PrimaryBrush}"
                                             Visibility="{Binding IsManual, Converter={StaticResource BoolToVisibility}}"/>

                    <TextBlock Text="{Binding SentAtText}"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding Recipient}"
                           FontSize="13"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextBrush}"/>

                <TextBlock Grid.Column="2"
                           Text="{Binding AmountText}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Foreground="{DynamicResource TextBrush}"/>

                <TextBlock Grid.Column="3"
                           Text="{Binding StatusText}"
                           FontSize="12"
                           MaxWidth="300"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ============ История отправок ============ -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,16">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="{loc:Tr Notif_Title}" Style="{StaticResource SectionTitle}"/>

                    <TextBlock Text="{Binding ScheduleText}"
                               FontSize="14"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>

                <!-- Что настроено в appsettings.json — только для чтения -->
                <Border Grid.Row="1"
                        Margin="0,14,0,0"
                        Padding="14,12"
                        CornerRadius="10"
                        Background="{DynamicResource Surface2Brush}">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <materialDesign:PackIcon Grid.Column="0"
                                                 Kind="CogOutline"
                                                 Width="18"
                                                 Height="18"
                                                 Margin="0,2,10,0"
                                                 VerticalAlignment="Top"
                                                 Foreground="{DynamicResource MutedBrush}"/>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{loc:Tr Notif_ConfigHint}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedBrush}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{loc:Tr Notif_ServerLabel}"
                                           FontSize="13"
                                           Margin="0,0,6,0"
                                           Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Text="{Binding MailServerText}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="{loc:Tr Notif_FromLabel}"
                                           FontSize="13"
                                           Margin="0,0,6,0"
                                           Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Text="{Binding MailFromText}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Рассылка выключена или не донастроена -->
                <Border Grid.Row="2"
                        Margin="0,10,0,0"
                        Padding="12,10"
                        CornerRadius="10"
                        Background="{DynamicResource Surface2Brush}"
                        BorderBrush="{DynamicResource WarningBrush}"
                        BorderThickness="1"
                        Visibility="{Binding ShowMailWarning, Converter={StaticResource BoolToVisibility}}">

                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AlertCircleOutline"
                                                 Width="18"
                                                 Height="18"
                                                 Margin="0,0,10,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource WarningBrush}"/>

                        <TextBlock Text="{Binding MailWarningText}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Журнал -->
                <Grid Grid.Row="3" Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{loc:Tr Notif_Log}"
                               Style="{StaticResource FieldCaption}"
                               Margin="0,0,0,12"/>

                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                            <ItemsControl ItemsSource="{Binding Log}"/>
                        </ScrollViewer>

                        <TextBlock Text="{loc:Tr Notif_LogEmpty}"
                                   Style="{StaticResource Muted}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsLogEmpty, Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- ============ Досрочная отправка ============ -->
        <Border Grid.Column="1"
                Width="380"
                Margin="18,0,0,0"
                Style="{StaticResource Card}"
                Padding="18,16">

            <StackPanel>

                <TextBlock Text="{loc:Tr Notif_EarlyTitle}" Style="{StaticResource FieldCaption}"/>

                <TextBlock Text="{loc:Tr Notif_EarlyHint}"
                           Style="{StaticResource Muted}"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"/>

                <!-- Кому -->
                <TextBlock Text="{loc:Tr Notif_EarlyTo}"
                           Style="{StaticResource Muted}"
                           Margin="2,18,0,7"/>

                <ComboBox ItemsSource="{Binding Debtors}"
                          SelectedItem="{Binding SelectedDebtor, Mode=TwoWay}"
                          DisplayMemberPath="Title"
                          IsEnabled="{Binding HasDebtors}"/>

                <TextBlock Text="{loc:Tr Notif_NoDebtors}"
                           Margin="2,8,0,0"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDebtors}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Button Style="{StaticResource PrimaryButton}"
                        Height="50"
                        FontSize="15"
                        Margin="0,16,0,0"
                        IsEnabled="{Binding CanSendToDebtor}"
                        Command="{Binding SendToDebtorCommand}">

                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="EmailFastOutline" Width="20" Height="20" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr Notif_EarlySend}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Separator Margin="0,20,0,16" Background="{DynamicResource LineBrush}"/>

                <!-- Плановая рассылка вручную: по всем, у кого наступил срок -->
                <TextBlock Text="{loc:Tr Notif_RunNowHint}"
                           Style="{StaticResource Muted}"
                           Margin="2,0,0,8"
                           TextWrapping="Wrap"/>

                <Button Style="{StaticResource SecondaryButton}"
                        Height="46"
                        Content="{loc:Tr Notif_RunNow}"
                        Command="{Binding RunNowCommand}"/>

                <Button Style="{StaticResource SecondaryButton}"
                        Height="42"
                        Margin="0,10,0,0"
                        Content="{loc:Tr Notif_Refresh}"
                        Command="{Binding RefreshCommand}"/>

                <TextBlock Margin="0,16,0,0"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Text="{Binding StatusMessage}"
                           Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">

                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
