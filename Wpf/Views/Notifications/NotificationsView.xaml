<UserControl x:Class="Wpf.Views.Notifications.NotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:common="clr-namespace:Wpf.Common"
             xmlns:loc="clr-namespace:Wpf.Localization"
             xmlns:vm="clr-namespace:Wpf.ViewModels.Notifications"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1200"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <common:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Переключатель как в редакторе чека -->
        <Style x:Key="SettingToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track"
                                Width="52"
                                Height="30"
                                CornerRadius="15"
                                Background="{DynamicResource LineBrush}">

                            <Border x:Name="Knob"
                                    Width="24"
                                    Height="24"
                                    Margin="3,0,0,0"
                                    CornerRadius="12"
                                    HorizontalAlignment="Left"
                                    Background="#FFFFFF"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Строка журнала рассылки ============ -->
        <DataTemplate DataType="{x:Type vm:ReminderLogItem}">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding SentAtText}"
                           FontSize="13"
                           Foreground="{DynamicResource MutedBrush}"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding Recipient}"
                           FontSize="13"
                           Margin="0,0,10,0"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextBrush}"/>

                <TextBlock Grid.Column="2"
                           Text="{Binding AmountText}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextAlignment="Right"
                           Margin="0,0,12,0"
                           Foreground="{DynamicResource TextBrush}"/>

                <TextBlock Grid.Column="3"
                           Text="{Binding StatusText}"
                           FontSize="12"
                           MaxWidth="260"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Настройки ============ -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,16">

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="{loc:Tr Notif_Title}" Style="{StaticResource SectionTitle}"/>

                            <TextBlock Text="{loc:Tr Notif_Subtitle}"
                                       FontSize="14"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <TextBlock Text="{loc:Tr Notif_Enabled}"
                                       FontSize="13"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedBrush}"/>

                            <CheckBox Style="{StaticResource SettingToggle}"
                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Десктоп: письма уходят только пока приложение открыто -->
                    <Border Margin="0,14,0,0"
                            Padding="12,10"
                            CornerRadius="10"
                            Background="{DynamicResource Surface2Brush}"
                            BorderBrush="{DynamicResource WarningBrush}"
                            BorderThickness="1">

                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertCircleOutline"
                                                     Width="18"
                                                     Height="18"
                                                     VerticalAlignment="Center"
                                                     Foreground="{DynamicResource WarningBrush}"/>

                            <TextBlock Text="{loc:Tr Notif_Warning}"
                                       Margin="10,0,0,0"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Сервер -->
                    <TextBlock Text="{loc:Tr Notif_Server}" Style="{StaticResource FieldCaption}" Margin="0,22,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="{loc:Tr Notif_Host}" Style="{StaticResource Muted}" Margin="2,0,0,7"/>
                            <TextBox Style="{StaticResource Field}" Text="{Binding SmtpHost, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,14,0">
                            <TextBlock Text="{loc:Tr Notif_Port}" Style="{StaticResource Muted}" Margin="2,0,0,7"/>
                            <TextBox Style="{StaticResource Field}"
                                     TextAlignment="Center"
                                     Text="{Binding SmtpPort, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,9">
                            <TextBlock Text="{loc:Tr Notif_Ssl}" Style="{StaticResource Muted}" Margin="0,0,0,7"/>
                            <CheckBox Style="{StaticResource SettingToggle}"
                                      HorizontalAlignment="Left"
                                      IsChecked="{Binding UseSsl, Mode=TwoWay}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Учётная запись -->
                    <TextBlock Text="{loc:Tr Notif_Account}" Style="{StaticResource FieldCaption}" Margin="0,18,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,7,0">
                            <TextBlock Text="{loc:Tr Notif_Username}" Style="{StaticResource Muted}" Margin="2,0,0,7"/>
                            <TextBox Style="{StaticResource Field}" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="7,0,0,0">
                            <TextBlock Text="{loc:Tr Notif_Password}" Style="{StaticResource Muted}" Margin="2,0,0,7"/>
                            <TextBox Style="{StaticResource Field}" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{loc:Tr Notif_PasswordNote}"
                               Style="{StaticResource Muted}"
                               FontSize="12"
                               Margin="2,7,0,0"
                               TextWrapping="Wrap"/>

                    <!-- Отправитель -->
                    <TextBlock Text="{loc:Tr Notif_Sender}" Style="{StaticResource FieldCaption}" Margin="0,18,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,7,0">
                            <TextBlock Text="{loc:Tr Notif_FromAddress}" Style="{StaticResource Muted}" Margin="2,0,0,7"/>
                            <TextBox Style="{StaticResource Field}" Text="{Binding FromAddress, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="7,0,0,0">
                            <TextBlock Text="{loc:Tr Notif_FromName}" Style="{StaticResource Muted}" Margin="2,0,0,7"/>
                            <TextBox Style="{StaticResource Field}" Text="{Binding FromName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Время рассылки -->
                    <TextBlock Text="{loc:Tr Notif_Times}" Style="{StaticResource FieldCaption}" Margin="0,18,0,10"/>

                    <TextBox Style="{StaticResource Field}" Text="{Binding SendTimes, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="{loc:Tr Notif_TimesHint}"
                               Style="{StaticResource Muted}"
                               FontSize="12"
                               Margin="2,7,0,0"/>

                    <!-- Действия -->
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource PrimaryButton}"
                                Height="52"
                                FontSize="16"
                                Margin="0,0,10,0"
                                Command="{Binding SaveCommand}">

                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSaveOutline" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr Notif_Save}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1"
                                Style="{StaticResource SecondaryButton}"
                                Height="52"
                                Content="{loc:Tr Notif_RunNow}"
                                Command="{Binding RunNowCommand}"/>
                    </Grid>

                    <!-- Пробное письмо -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="{loc:Tr Notif_TestHint}" Style="{StaticResource Muted}" Margin="2,0,0,7"/>
                            <TextBox Style="{StaticResource Field}" Text="{Binding TestRecipient, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Style="{StaticResource SecondaryButton}"
                                Height="48"
                                VerticalAlignment="Bottom"
                                Content="{loc:Tr Notif_Test}"
                                Command="{Binding TestCommand}"/>
                    </Grid>

                    <TextBlock Margin="0,14,0,0"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Text="{Binding StatusMessage}"
                               Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ============ Журнал рассылки ============ -->
        <Border Grid.Column="1"
                Width="520"
                Margin="18,0,0,0"
                Style="{StaticResource Card}"
                Padding="18,16">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{loc:Tr Notif_Log}"
                           Style="{StaticResource FieldCaption}"
                           Margin="0,0,0,14"/>

                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <ItemsControl ItemsSource="{Binding Log}"/>
                    </ScrollViewer>

                    <TextBlock Text="{loc:Tr Notif_LogEmpty}"
                               Style="{StaticResource Muted}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsLogEmpty, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
