<UserControl x:Class="Wpf.Views.Labels.LabelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:common="clr-namespace:Wpf.Common"
             xmlns:loc="clr-namespace:Wpf.Localization"
             xmlns:vm="clr-namespace:Wpf.ViewModels.Labels"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1200"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <common:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <common:EmptyStringToVisibilityConverter x:Key="EmptyToVisibility"/>

        <Style x:Key="ProductRow" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Margin="0,0,0,6"
                                Padding="12,10"
                                CornerRadius="10"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1"
                                SnapsToDevicePixels="True">

                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Товар в списке ============ -->
        <DataTemplate DataType="{x:Type vm:LabelProductItem}">
            <Button Style="{StaticResource ProductRow}"
                    Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock Text="{Binding CategoryName}"
                                   Style="{StaticResource Muted}"
                                   FontSize="11"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Код выдан нами, а не заводом -->
                        <materialDesign:PackIcon Kind="StoreOutline"
                                                 Width="13"
                                                 Height="13"
                                                 Margin="0,0,5,0"
                                                 VerticalAlignment="Center"
                                                 ToolTip="{loc:Tr Labels_InternalTip}"
                                                 Foreground="{DynamicResource PrimaryBrush}"
                                                 Visibility="{Binding IsInternal, Converter={StaticResource BoolToVisibility}}"/>

                        <TextBlock Text="{Binding BarcodeText}"
                                   FontSize="12"
                                   FontFamily="Consolas"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasBarcode}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Text="{Binding PriceText}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}"/>
                </Grid>
            </Button>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Товары ============ -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16,14">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <TextBox Style="{StaticResource Field}"
                                 FontSize="14"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"/>

                        <TextBlock Text="{loc:Tr Labels_SearchHint}"
                                   Margin="13,0,0,0"
                                   FontSize="13"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding SearchText, Converter={StaticResource EmptyToVisibility}}"/>

                        <Button Style="{StaticResource MiniIconButton}"
                                HorizontalAlignment="Right"
                                Margin="0,0,6,0"
                                ToolTip="{loc:Tr Common_ClearSearch}"
                                Command="{Binding ClearSearchCommand}"
                                Visibility="{Binding HasSearch, Converter={StaticResource BoolToVisibility}}">

                            <materialDesign:PackIcon Kind="Close" Width="15" Height="15"/>
                        </Button>
                    </Grid>

                    <TextBlock Grid.Column="1"
                               Style="{StaticResource Muted}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Text="{Binding CountText}"/>
                </Grid>

                <CheckBox Grid.Row="1"
                          Margin="2,0,0,12"
                          Content="{loc:Tr Labels_OnlyWithout}"
                          IsChecked="{Binding OnlyWithoutBarcode, Mode=TwoWay}"/>

                <Grid Grid.Row="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <ItemsControl ItemsSource="{Binding Items}"/>
                    </ScrollViewer>

                    <TextBlock Text="{Binding EmptyText}"
                               Style="{StaticResource Muted}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="420"
                               TextAlignment="Center"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ============ Карточка кода и этикетки ============ -->
        <Border Grid.Column="1"
                Width="400"
                Margin="18,0,0,0"
                Style="{StaticResource Card}"
                Padding="18,16"
                Visibility="{Binding HasEditor, Converter={StaticResource BoolToVisibility}}">

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding Selected.Name}"
                                   Style="{StaticResource FieldCaption}"
                                   TextTrimming="CharacterEllipsis"/>

                        <Button Grid.Column="1"
                                Style="{StaticResource MiniIconButton}"
                                Width="28"
                                Height="28"
                                ToolTip="{loc:Tr Common_Close}"
                                Command="{Binding CloseCommand}">

                            <materialDesign:PackIcon Kind="Close" Width="15" Height="15"/>
                        </Button>
                    </Grid>

                    <!-- Код -->
                    <TextBlock Text="{loc:Tr Labels_Barcode}" Style="{StaticResource Muted}" Margin="2,16,0,7"/>

                    <TextBox Style="{StaticResource Field}"
                             FontFamily="Consolas"
                             FontSize="15"
                             Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="{Binding BarcodeHint}"
                               FontSize="12"
                               Margin="2,7,0,0"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBarcodeValid}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource SecondaryButton}"
                                Height="44"
                                Margin="0,0,5,0"
                                IsEnabled="{Binding CanGenerate}"
                                Command="{Binding GenerateCommand}">

                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AutoFix" Width="17" Height="17" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr Labels_Generate}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1"
                                Style="{StaticResource SecondaryButton}"
                                Height="44"
                                Margin="5,0,0,0"
                                Content="{loc:Tr Common_Save}"
                                Command="{Binding SaveBarcodeCommand}"/>
                    </Grid>

                    <!-- Содержимое этикетки -->
                    <TextBlock Text="{loc:Tr Labels_Content}" Style="{StaticResource FieldCaption}" Margin="0,22,0,10"/>

                    <CheckBox Content="{loc:Tr Labels_ShowName}" IsChecked="{Binding ShowName, Mode=TwoWay}" Margin="0,0,0,8"/>
                    <CheckBox Content="{loc:Tr Labels_ShowPrice}" IsChecked="{Binding ShowPrice, Mode=TwoWay}" Margin="0,0,0,8"/>
                    <CheckBox Content="{loc:Tr Labels_ShowSku}" IsChecked="{Binding ShowSku, Mode=TwoWay}"/>

                    <!-- Предпросмотр -->
                    <TextBlock Text="{loc:Tr Labels_Preview}" Style="{StaticResource FieldCaption}" Margin="0,20,0,10"/>

                    <Border Padding="12,12"
                            CornerRadius="10"
                            Background="{DynamicResource Surface2Brush}">

                        <TextBlock Text="{Binding Preview}"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   TextWrapping="NoWrap"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </Border>

                    <!-- Печать -->
                    <TextBlock Text="{loc:Tr Labels_Copies}" Style="{StaticResource Muted}" Margin="2,18,0,7"/>

                    <TextBox Style="{StaticResource Field}"
                             TextAlignment="Right"
                             Text="{Binding Copies, UpdateSourceTrigger=PropertyChanged}"/>

                    <Button Style="{StaticResource PrimaryButton}"
                            Height="50"
                            FontSize="15"
                            Margin="0,14,0,0"
                            IsEnabled="{Binding CanPrint}"
                            Command="{Binding PrintCommand}">

                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PrinterOutline" Width="20" Height="20" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr Labels_Print}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Margin="0,14,0,0"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Text="{Binding StatusMessage}"
                               Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
