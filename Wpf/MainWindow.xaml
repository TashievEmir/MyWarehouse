<Window x:Class="Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мой склад"
        WindowState="Maximized"
        ResizeMode="CanResize">

    <Window.Resources>

        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2D2D44"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E5A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D2D44"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <!-- 🌈 Background -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1E1E2F" Offset="0"/>
                <GradientStop Color="#2B2B45" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Главный layout -->
        <Grid>

            <!-- Sidebar + Main -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="1*"/>
                <ColumnDefinition Width="9*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0"
                    Background="#181825">

                <StackPanel Margin="10">

                    <Button Click="ToggleSidebar"
                            Width="40"
                            Height="40"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="5">

                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE700;"
                                   FontSize="20"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>

                    <Button Style="{StaticResource SidebarButton}"
                             Command="{Binding ShowDashboardCommand}">

                        <StackPanel Orientation="Horizontal">

                            <!-- icon -->
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE80F;"
                                       FontSize="16"
                                       Width="30"/>

                            <!-- text -->
                            <TextBlock x:Name="DashboardText"
                                       Text="Главная"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>
                    <Button Style="{StaticResource SidebarButton}"
                            Command="{Binding ShowProductsCommand}">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE14C;"
                                       FontSize="16"
                                       Width="30"/>

                            <TextBlock x:Name="ProductsText"
                                       Text="Продукты"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>
                    <Button Style="{StaticResource SidebarButton}"
                            Command="{Binding ShowSalesCommand}">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xEAFD;"
                                       FontSize="16"
                                       Width="30"/>

                            <TextBlock x:Name="SalesText"
                                       Text="Продажи"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>
                    <Button Style="{StaticResource SidebarButton}"
                            Command="{Binding ShowPurchasesCommand}">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE8A1;"
                                       FontSize="16"
                                       Width="30"/>

                            <TextBlock x:Name="PurchasesText"
                                       Text="Покупки"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>
                    <Button Style="{StaticResource SidebarButton}"
                            Command="{Binding ShowDebtsCommand}">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE9D2;"
                                       FontSize="16"
                                       Width="30"/>

                            <TextBlock x:Name="DebtsText"
                                       Text="Долги"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                </StackPanel>
            </Border>

            <!-- Правая часть -->
            <Grid Grid.Column="1">

                <Grid.RowDefinitions>
                    <RowDefinition Height="0.5*"/>
                    <RowDefinition Height="9*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0"
                        Background="#252538"
                        Padding="20">

                    <TextBlock Text="Header"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Content -->
                <Border Grid.Row="1"
                        Background="#F5F5F5"
                        Padding="20">

                    <ContentControl Content="{Binding CurrentView}" />
                </Border>

            </Grid>

        </Grid>
    </Grid>

</Window>
