<Window x:Class="Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:common="clr-namespace:Wpf.Common"
        Title="Мой склад"
        WindowState="Maximized"
        ResizeMode="CanResize"
        MinWidth="880"
        MinHeight="560"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI"
        Background="{StaticResource CanvasBrush}">

    <Window.Resources>

        <common:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <common:MinWidthToVisibilityConverter x:Key="MinWidthToVisibility"/>
        <common:EqualsConverter x:Key="Equals"/>
        <common:InitialsConverter x:Key="Initials"/>

        <!-- Пункт бокового меню: иконка задаётся через common:Nav.Icon,
             активное состояние — через common:Nav.PageKey + MainViewModel.CurrentPage -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="12,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedOnDarkBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bg"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="10"/>

                            <Border x:Name="ActiveBar"
                                    Width="3"
                                    Height="22"
                                    Margin="-8,0,0,0"
                                    HorizontalAlignment="Left"
                                    CornerRadius="2"
                                    Background="{StaticResource BrandLightBrush}"
                                    Visibility="Collapsed"/>

                            <Grid x:Name="Row" Margin="14,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <materialDesign:PackIcon x:Name="Icon"
                                                         Grid.Column="0"
                                                         Width="21"
                                                         Height="21"
                                                         VerticalAlignment="Center"
                                                         Foreground="{TemplateBinding Foreground}"
                                                         Kind="{Binding (common:Nav.Icon), RelativeSource={RelativeSource TemplatedParent}}"/>

                                <TextBlock x:Name="Label"
                                           Grid.Column="1"
                                           Margin="14,0,0,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{TemplateBinding Content}"/>
                            </Grid>
                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource NavHoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextOnDarkBrush}"/>
                            </Trigger>

                            <!-- Активная страница -->
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource Equals}">
                                        <Binding Path="(common:Nav.PageKey)" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="DataContext.CurrentPage" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    </MultiBinding>
                                </DataTrigger.Binding>

                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource NavActiveBrush}"/>
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource BrandLightBrush}"/>
                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="White"/>
                            </DataTrigger>

                            <!-- Свёрнутое меню: прячем подпись и центрируем иконку -->
                            <DataTrigger Binding="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter TargetName="Label" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Row" Property="Margin" Value="0"/>
                                <Setter TargetName="Row" Property="HorizontalAlignment" Value="Center"/>
                            </DataTrigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Заголовок группы пунктов (виден только в развёрнутом меню) -->
        <Style x:Key="NavCaption" TargetType="TextBlock">
            <Setter Property="Margin" Value="26,18,26,8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource SidebarCaptionBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ...а в свёрнутом вместо него — разделитель -->
        <Style x:Key="NavCaptionRule" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="20,18,20,14"/>
            <Setter Property="Background" Value="{StaticResource SidebarLineBrush}"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Круглая кнопка-иконка в хедере -->
        <Style x:Key="HeaderIconButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Боковое меню ============ -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                ClipToBounds="True">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Логотип -->
                <Grid Grid.Row="0" Height="72" Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="36"
                            Height="36"
                            CornerRadius="10"
                            VerticalAlignment="Center"
                            Background="{StaticResource BrandGradientBrush}">

                        <materialDesign:PackIcon Kind="Warehouse"
                                                 Width="20"
                                                 Height="20"
                                                 Foreground="White"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">

                        <TextBlock Text="MyWarehouse"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock Text="Управление складом"
                                   FontSize="11"
                                   Margin="0,1,0,0"
                                   Foreground="{StaticResource SidebarCaptionBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <!-- Пункты -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Margin="0,4,0,12">

                        <TextBlock Style="{StaticResource NavCaption}" Text="ОБЗОР"/>
                        <Border Style="{StaticResource NavCaptionRule}"/>

                        <Button Style="{StaticResource NavButton}"
                                Content="Главная"
                                common:Nav.Icon="ViewDashboardOutline"
                                common:Nav.PageKey="Dashboard"
                                Command="{Binding ShowDashboardCommand}"/>

                        <Button Style="{StaticResource NavButton}"
                                Content="Товары"
                                common:Nav.Icon="PackageVariantClosed"
                                common:Nav.PageKey="Products"
                                Command="{Binding ShowProductsCommand}"/>

                        <TextBlock Style="{StaticResource NavCaption}" Text="ОПЕРАЦИИ"/>
                        <Border Style="{StaticResource NavCaptionRule}"/>

                        <Button Style="{StaticResource NavButton}"
                                Content="Продажи"
                                common:Nav.Icon="CashMultiple"
                                common:Nav.PageKey="Sales"
                                Command="{Binding ShowSalesCommand}"/>

                        <Button Style="{StaticResource NavButton}"
                                Content="Покупки"
                                common:Nav.Icon="CartOutline"
                                common:Nav.PageKey="Purchases"
                                Command="{Binding ShowPurchasesCommand}"/>

                        <Button Style="{StaticResource NavButton}"
                                Content="Долги"
                                common:Nav.Icon="CreditCardClockOutline"
                                common:Nav.PageKey="Debts"
                                Command="{Binding ShowDebtsCommand}"/>

                    </StackPanel>
                </ScrollViewer>

                <!-- Подвал -->
                <Border Grid.Row="2"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{StaticResource SidebarLineBrush}"
                        Padding="20,14">

                    <TextBlock Foreground="{StaticResource SidebarCaptionBrush}"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="v1.0"/>
                </Border>

            </Grid>
        </Border>

        <!-- ============ Правая часть ============ -->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Хедер -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,0,0,1">

                <Grid Margin="12,0,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Кнопка сворачивания меню -->
                    <Button Grid.Column="0"
                            Style="{StaticResource HeaderIconButton}"
                            Click="ToggleSidebar"
                            ToolTip="Свернуть / развернуть меню">

                        <materialDesign:PackIcon x:Name="ToggleIcon"
                                                 Kind="Backburger"
                                                 Width="22"
                                                 Height="22"/>
                    </Button>

                    <!-- Заголовок страницы -->
                    <StackPanel Grid.Column="1"
                                Margin="14,0,16,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="{Binding PageTitle}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock Text="{Binding PageSubtitle}"
                                   FontSize="12"
                                   Margin="0,1,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource MinWidthToVisibility}, ConverterParameter=1000}"/>
                    </StackPanel>

                    <!-- Дата + пользователь -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Border CornerRadius="8"
                                Padding="10,6"
                                Background="{StaticResource CanvasBrush}"
                                VerticalAlignment="Center"
                                Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource MinWidthToVisibility}, ConverterParameter=1080}">

                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarBlankOutline"
                                                         Width="16"
                                                         Height="16"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource TextSecondaryBrush}"/>

                                <TextBlock Text="{Binding Today}"
                                           Margin="8,0,0,0"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Width="1"
                                Height="26"
                                Margin="14,0"
                                Background="{StaticResource LineBrush}"
                                Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource MinWidthToVisibility}, ConverterParameter=1080}"/>

                        <Border Width="36"
                                Height="36"
                                CornerRadius="18"
                                Background="{StaticResource BrandGradientBrush}">

                            <TextBlock Text="{Binding UserName, Converter={StaticResource Initials}}"
                                       Foreground="White"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource MinWidthToVisibility}, ConverterParameter=920}">

                            <TextBlock Text="{Binding UserName}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>

                            <TextBlock Text="{Binding UserRole}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- Контент -->
            <Border Grid.Row="1"
                    Background="{StaticResource CanvasBrush}"
                    Padding="24">

                <ContentControl Content="{Binding CurrentView}"/>
            </Border>

        </Grid>
    </Grid>

</Window>
