<Window x:Class="Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:common="clr-namespace:Wpf.Common"
        xmlns:loc="clr-namespace:Wpf.Localization"
        xmlns:shell="clr-namespace:Wpf.Views.Shell"
        Title="{loc:Tr App_Title}"
        WindowState="Maximized"
        ResizeMode="CanResize"
        MinWidth="1000"
        MinHeight="620"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI"
        Background="{DynamicResource BgBrush}">

    <Window.Resources>
        <common:MinWidthToVisibilityConverter x:Key="MinWidthToVisibility"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ Верхнее меню ============ -->
        <shell:NavBarView Grid.Row="0"/>

        <!-- ============ Заголовок страницы ============ -->
        <Border Grid.Row="1"
                Height="64"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1">

            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">

                    <TextBlock Text="{Binding PageTitle}"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               TextTrimming="CharacterEllipsis"/>

                    <TextBlock Text="{Binding PageSubtitle}"
                               FontSize="13"
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource MutedBrush}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource MinWidthToVisibility}, ConverterParameter=1100}"/>
                </StackPanel>

                <Border Grid.Column="1"
                        CornerRadius="10"
                        Padding="12,7"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Surface2Brush}">

                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CalendarBlankOutline"
                                                 Width="17"
                                                 Height="17"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource MutedBrush}"/>

                        <TextBlock Text="{Binding Today}"
                                   Margin="8,0,0,0"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============ Контент ============ -->
        <Border Grid.Row="2"
                Background="{DynamicResource BgBrush}"
                Padding="24">

            <ContentControl Content="{Binding CurrentView}"/>
        </Border>
    </Grid>

</Window>
