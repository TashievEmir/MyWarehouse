<Window x:Class="Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:common="clr-namespace:Wpf.Common"
        xmlns:loc="clr-namespace:Wpf.Localization"
        Title="{loc:Tr App_Title}"
        WindowState="Maximized"
        ResizeMode="CanResize"
        MinWidth="1000"
        MinHeight="620"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI"
        Background="{DynamicResource BgBrush}">

    <Window.Resources>

        <common:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <common:MinWidthToVisibilityConverter x:Key="MinWidthToVisibility"/>
        <common:EqualsConverter x:Key="Equals"/>
        <common:InitialsConverter x:Key="Initials"/>

        <!-- Пункт верхнего уровня: иконка через common:Nav.Icon,
             активное состояние — common:Nav.PageKey + MainViewModel.CurrentPage -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="12,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource NavTextBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="11"/>

                            <Border x:Name="ActiveBar"
                                    Width="3"
                                    Height="22"
                                    Margin="-8,0,0,0"
                                    HorizontalAlignment="Left"
                                    CornerRadius="2"
                                    Background="{DynamicResource PrimaryBrush}"
                                    Visibility="Collapsed"/>

                            <Grid x:Name="Row" Margin="14,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <materialDesign:PackIcon x:Name="Icon"
                                                         Grid.Column="0"
                                                         Width="22"
                                                         Height="22"
                                                         VerticalAlignment="Center"
                                                         Foreground="{TemplateBinding Foreground}"
                                                         Kind="{Binding (common:Nav.Icon), RelativeSource={RelativeSource TemplatedParent}}"/>

                                <TextBlock x:Name="Label"
                                           Grid.Column="1"
                                           Margin="15,0,0,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{TemplateBinding Content}"/>

                                <ContentPresenter Grid.Column="2"
                                                  x:Name="Badge"
                                                  VerticalAlignment="Center"
                                                  Content="{Binding (common:Nav.Badge), RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Grid>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource NavActiveBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>

                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource Equals}">
                                        <Binding Path="(common:Nav.PageKey)" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="DataContext.CurrentPage" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    </MultiBinding>
                                </DataTrigger.Binding>

                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource NavActiveBrush}"/>
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter TargetName="Label" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Badge" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Row" Property="Margin" Value="0"/>
                                <Setter TargetName="Row" Property="HorizontalAlignment" Value="Center"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Заголовок группы с подпунктами: не кликается -->
        <Style x:Key="NavGroup" TargetType="Border">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="12,6,12,0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Пункт субменю -->
        <Style x:Key="NavSubButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="12,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource NavTextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="11">
                            <Grid Margin="14,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="37"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Ellipse x:Name="Marker"
                                         Grid.Column="0"
                                         Width="5"
                                         Height="5"
                                         HorizontalAlignment="Left"
                                         Margin="9,0,0,0"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource NavCaptionBrush}"/>

                                <TextBlock x:Name="Label"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{TemplateBinding Content}"/>

                                <ContentPresenter Grid.Column="2"
                                                  VerticalAlignment="Center"
                                                  Content="{Binding (common:Nav.Badge), RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource NavActiveBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>

                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource Equals}">
                                        <Binding Path="(common:Nav.PageKey)" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="DataContext.CurrentPage" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    </MultiBinding>
                                </DataTrigger.Binding>

                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource NavActiveBrush}"/>
                                <Setter TargetName="Marker" Property="Fill" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Заголовок раздела меню -->
        <Style x:Key="NavCaption" TargetType="TextBlock">
            <Setter Property="Margin" Value="26,20,26,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource NavCaptionBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ...а в свёрнутом меню вместо него разделитель -->
        <Style x:Key="NavCaptionRule" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="20,18,20,14"/>
            <Setter Property="Background" Value="{DynamicResource NavLineBrush}"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Подпункты и заголовки групп прячутся в свёрнутом меню -->
        <Style x:Key="NavSubGroup" TargetType="StackPanel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Круглая кнопка-иконка в хедере -->
        <Style x:Key="HeaderIconButton" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка темы в подвале сайдбара -->
        <Style x:Key="ThemeButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource NavTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                CornerRadius="9"
                                Background="Transparent"
                                BorderBrush="{DynamicResource NavLineBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource NavActiveBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Бейдж количества у пункта меню -->
        <Style x:Key="NavBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="268"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Боковое меню ============ -->
        <Border Grid.Column="0" Background="{DynamicResource NavBgBrush}" ClipToBounds="True">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Логотип -->
                <Grid Grid.Row="0" Height="84" Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="42"
                            Height="42"
                            CornerRadius="13"
                            VerticalAlignment="Center"
                            Background="{DynamicResource BrandGradientBrush}">

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Rectangle Width="20" Height="4" RadiusX="2" RadiusY="2" Fill="#FFFFFF"/>
                            <Rectangle Width="14" Height="4" RadiusX="2" RadiusY="2" Fill="#FFFFFF" Opacity="0.7" Margin="0,3"/>
                            <Rectangle Width="20" Height="4" RadiusX="2" RadiusY="2" Fill="#FFFFFF"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">

                        <TextBlock Text="{loc:Tr App_Title}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock Text="{loc:Tr App_Tagline}"
                                   FontSize="12"
                                   Margin="0,1,0,0"
                                   Foreground="{DynamicResource NavCaptionBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <!-- Пункты -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Margin="0,4,0,12">

                        <TextBlock Style="{StaticResource NavCaption}" Text="{loc:Tr Nav_Group_Overview}"/>
                        <Border Style="{StaticResource NavCaptionRule}"/>

                        <Button Style="{StaticResource NavButton}"
                                Content="{loc:Tr Nav_Dashboard}"
                                common:Nav.Icon="ViewDashboardOutline"
                                common:Nav.PageKey="dashboard"
                                Command="{Binding ShowDashboardCommand}"
                                Visibility="{Binding CanSeeOverview, Converter={StaticResource BoolToVisibility}}"/>

                        <Button Style="{StaticResource NavButton}"
                                Content="{loc:Tr Nav_Sales}"
                                common:Nav.Icon="CashRegister"
                                common:Nav.PageKey="sales"
                                Command="{Binding ShowSalesCommand}"/>

                        <TextBlock Style="{StaticResource NavCaption}" Text="{loc:Tr Nav_Group_Warehouse}"/>
                        <Border Style="{StaticResource NavCaptionRule}"/>

                        <!-- Товары -->
                        <Border Style="{StaticResource NavGroup}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="PackageVariantClosed"
                                                         Width="22"
                                                         Height="22"
                                                         VerticalAlignment="Center"
                                                         Foreground="{DynamicResource NavTextBrush}"/>

                                <TextBlock Text="{loc:Tr Nav_Products}"
                                           Margin="15,0,0,0"
                                           FontSize="15"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource NavTextBrush}"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Style="{StaticResource NavSubGroup}">
                            <Button Style="{StaticResource NavSubButton}"
                                    Content="{loc:Tr Nav_Catalog}"
                                    common:Nav.PageKey="catalog"
                                    Command="{Binding ShowCatalogCommand}"/>

                            <Button Style="{StaticResource NavSubButton}"
                                    Content="{loc:Tr Nav_Receiving}"
                                    common:Nav.PageKey="receiving"
                                    Command="{Binding ShowReceivingCommand}"/>
                        </StackPanel>

                        <!-- Чеки: кассиру не нужны -->
                        <StackPanel Visibility="{Binding CanSeeReceipts, Converter={StaticResource BoolToVisibility}}">

                        <Border Style="{StaticResource NavGroup}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="ReceiptTextOutline"
                                                         Width="22"
                                                         Height="22"
                                                         VerticalAlignment="Center"
                                                         Foreground="{DynamicResource NavTextBrush}"/>

                                <TextBlock Text="{loc:Tr Nav_Receipts}"
                                           Margin="15,0,0,0"
                                           FontSize="15"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource NavTextBrush}"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Style="{StaticResource NavSubGroup}">
                            <Button Style="{StaticResource NavSubButton}"
                                    Content="{loc:Tr Nav_ReceiptsList}"
                                    common:Nav.PageKey="receipts"
                                    Command="{Binding ShowReceiptsCommand}"/>

                            <Button Style="{StaticResource NavSubButton}"
                                    Content="{loc:Tr Nav_ReceiptEditor}"
                                    common:Nav.PageKey="editor"
                                    Command="{Binding ShowReceiptTemplateCommand}"
                                    Visibility="{Binding CanEditReceiptTemplate, Converter={StaticResource BoolToVisibility}}">

                                <common:Nav.Badge>
                                    <Border CornerRadius="7"
                                            Padding="6,1"
                                            BorderBrush="{DynamicResource NavLineBrush}"
                                            BorderThickness="1">

                                        <TextBlock Text="{loc:Tr Nav_Badge_Admin}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource NavCaptionBrush}"/>
                                    </Border>
                                </common:Nav.Badge>
                            </Button>
                        </StackPanel>

                        </StackPanel>

                        <!-- Аналитика: сводные экраны для админа и менеджера -->
                        <StackPanel Visibility="{Binding CanSeeAnalytics, Converter={StaticResource BoolToVisibility}}">

                        <TextBlock Style="{StaticResource NavCaption}" Text="{loc:Tr Nav_Group_Analytics}"/>
                        <Border Style="{StaticResource NavCaptionRule}"/>

                        <Button Style="{StaticResource NavButton}"
                                Content="{loc:Tr Nav_History}"
                                common:Nav.Icon="History"
                                common:Nav.PageKey="history"
                                Command="{Binding ShowActivityLogCommand}"/>

                        <!-- Статистика -->
                        <Border Style="{StaticResource NavGroup}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="ChartLine"
                                                         Width="22"
                                                         Height="22"
                                                         VerticalAlignment="Center"
                                                         Foreground="{DynamicResource NavTextBrush}"/>

                                <TextBlock Text="{loc:Tr Nav_Statistics}"
                                           Margin="15,0,0,0"
                                           FontSize="15"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource NavTextBrush}"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Style="{StaticResource NavSubGroup}">
                            <Button Style="{StaticResource NavSubButton}"
                                    Content="{loc:Tr Nav_Stock}"
                                    common:Nav.PageKey="stock"
                                    Command="{Binding ShowStockCommand}"/>

                            <Button Style="{StaticResource NavSubButton}"
                                    Content="{loc:Tr Nav_Debts}"
                                    common:Nav.PageKey="debts"
                                    Command="{Binding ShowDebtsCommand}">

                                <common:Nav.Badge>
                                    <Border Style="{StaticResource NavBadge}"
                                            Visibility="{Binding DataContext.HasDebts, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">

                                        <TextBlock Text="{Binding DataContext.DebtsCount, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFFFFF"/>
                                    </Border>
                                </common:Nav.Badge>
                            </Button>

                            <Button Style="{StaticResource NavSubButton}"
                                    Content="{loc:Tr Nav_Purchases}"
                                    common:Nav.PageKey="purchases"
                                    Command="{Binding ShowPurchasesCommand}"/>
                        </StackPanel>

                        </StackPanel>

                        <!-- Настройки видит тот же круг, что и аналитику -->
                        <StackPanel Visibility="{Binding CanSeeSettings, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource NavCaption}" Text="{loc:Tr Nav_Group_Settings}"/>
                            <Border Style="{StaticResource NavCaptionRule}"/>

                            <Button Style="{StaticResource NavButton}"
                                    Content="{loc:Tr Nav_Notifications}"
                                    common:Nav.Icon="BellOutline"
                                    common:Nav.PageKey="notifications"
                                    Command="{Binding ShowNotificationsCommand}"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!-- Подвал -->
                <Border Grid.Row="2"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource NavLineBrush}"
                        Padding="20,14">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{loc:Tr App_Version}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource NavCaptionBrush}"
                                   Visibility="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>

                        <!-- Язык: показываем код, на который переключимся -->
                        <Button Grid.Column="1"
                                Style="{StaticResource ThemeButton}"
                                Margin="0,0,6,0"
                                Command="{Binding ToggleLanguageCommand}"
                                ToolTip="{loc:Tr Tip_ToggleLanguage}">

                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Translate" Width="16" Height="16" VerticalAlignment="Center"/>

                                <TextBlock Text="{Binding LanguageLabel}"
                                           Margin="6,0,0,0"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2"
                                Style="{StaticResource ThemeButton}"
                                Command="{Binding ToggleThemeCommand}"
                                ToolTip="{loc:Tr Tip_ToggleTheme}">

                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ThemeLightDark" Width="16" Height="16" VerticalAlignment="Center"/>

                                <TextBlock Text="{Binding ThemeLabel}"
                                           Margin="7,0,0,0"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

            </Grid>
        </Border>

        <!-- ============ Правая часть ============ -->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="76"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Хедер -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="0,0,0,1">

                <Grid Margin="12,0,24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource HeaderIconButton}"
                            Click="ToggleSidebar"
                            ToolTip="{loc:Tr Tip_ToggleSidebar}">

                        <materialDesign:PackIcon x:Name="ToggleIcon" Kind="Backburger" Width="22" Height="22"/>
                    </Button>

                    <StackPanel Grid.Column="1"
                                Margin="16,0,16,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="{Binding PageTitle}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock Text="{Binding PageSubtitle}"
                                   FontSize="13"
                                   Margin="0,2,0,0"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource MinWidthToVisibility}, ConverterParameter=1100}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Border CornerRadius="10"
                                Padding="12,7"
                                Background="{DynamicResource Surface2Brush}"
                                VerticalAlignment="Center"
                                Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource MinWidthToVisibility}, ConverterParameter=1180}">

                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarBlankOutline"
                                                         Width="17"
                                                         Height="17"
                                                         VerticalAlignment="Center"
                                                         Foreground="{DynamicResource MutedBrush}"/>

                                <TextBlock Text="{Binding Today}"
                                           Margin="8,0,0,0"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Width="1"
                                Height="28"
                                Margin="16,0"
                                Background="{DynamicResource LineBrush}"
                                Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource MinWidthToVisibility}, ConverterParameter=1180}"/>

                        <Border Width="40"
                                Height="40"
                                CornerRadius="20"
                                Background="{DynamicResource BrandGradientBrush}">

                            <TextBlock Text="{Binding UserName, Converter={StaticResource Initials}}"
                                       Foreground="White"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Margin="11,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource MinWidthToVisibility}, ConverterParameter=1000}">

                            <TextBlock Text="{Binding UserName}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"
                                       TextTrimming="CharacterEllipsis"/>

                            <TextBlock Text="{Binding UserRole}"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- Контент -->
            <Border Grid.Row="1"
                    Background="{DynamicResource BgBrush}"
                    Padding="24">

                <ContentControl Content="{Binding CurrentView}"/>
            </Border>

        </Grid>
    </Grid>

</Window>
